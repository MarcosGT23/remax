{
  "kind": "collectionType",
  "collectionName": "agentes",
  "info": {
    "singularName": "agente",
    "pluralName": "agentes",
    "displayName": "Agente",
    "description": "Colección de agentes inmobiliarios con redes sociales, especialidad, biografía y propiedades a cargo"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "role": {
      "type": "string",
      "required": true
    },
    "specialty": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "propertiesCount": {
      "type": "integer"
    },
    "city": {
      "type": "enumeration",
      "enum": ["Santa Cruz", "La Paz", "Cochabamba"]
    },
    "zone": {
      "type": "string"
    },
    "experience": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "initials": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "facebook": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "propiedades": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::propiedad.propiedad",
      "mappedBy": "agent"
    }
  }
}
