---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "RoofPro - Roofing Services Website Template", 
  description = "RoofPro Services is a modern and professional roofing service template designed for roofing companies, contractors, and construction businesses."
} = Astro.props;
---

<!DOCTYPE html>
<html data-wf-page="6a5717b9f45479999f4fa9d7" lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="/images/og-image-1200x630.jpg" property="og:image" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content="/images/og-image-1200x630.jpg" name="twitter:image" />
    <meta property="og:type" content="website" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta name="generator" content={Astro.generator} />
    
    <link href="/css/normalize.css" rel="stylesheet" type="text/css" />
    <link href="/css/base.css" rel="stylesheet" type="text/css" />
    <link href="/css/app.css" rel="stylesheet" type="text/css" />
    
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <script is:inline src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
    <script is:inline type="text/javascript">
      WebFont.load({ google: { families: ["Outfit:300,400,500,600,700,800,900"] } });
    </script>
    <script is:inline type="text/javascript">
      !function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);
    </script>
    
    <style is:global>
      :root {
        --font-family--heading-font: 'Gotham Black', 'Gotham', 'Outfit', sans-serif;
        --font-family--main-font: 'Outfit', sans-serif;
        --_colors---porcelain-color: #f7f5ee;
        --_colors---crema-color: #f7f5ee;
        --_colors---body-text-color: #000000;
        --_colors---title-text-color: #000e35;
        --_colors---primary-color: #0043ff;
        --_colors---blue-color: #0043ff;
        --_colors---dark-blue-color: #000e35;
        --_colors---red-color: #ff1200;
        --_colors---dark-red-color: #660000;
        --_colors---orange-color: #ff1200;
        --_colors---black-color: #000000;
        --_colors---strock-color: #e0dcd3;
        --_colors---nevi-blue-0-71: #000e35b5;
      }

      body {
        font-family: 'Outfit', sans-serif !important;
        background-color: #f7f5ee !important;
        color: #000000 !important;
      }

      h1, h2, h3, h4, h5, h6,
      .heading-style-1, .heading-style-2, .heading-style-3,
      .heading-style-4, .heading-style-5, .heading-style-6,
      .heading-h1, .heading-h2, .heading-h3, .heading-h4, .heading-h5, .heading-h6 {
        font-family: 'Gotham Black', 'Gotham', 'Outfit', sans-serif !important;
        font-weight: 900 !important;
        letter-spacing: -0.02em;
      }
    </style>

    <link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/images/webclip.png" rel="apple-touch-icon" />
    <slot name="head" />
  </head>
  <body>
    <div class="page-wrapper">
      <slot />
    </div>

    <script is:inline src="/js/jquery.min.js" type="text/javascript"></script>
    <script is:inline src="/js/site.js" type="text/javascript"></script>
  </body>
</html>
