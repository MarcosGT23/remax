<style>
  /* Brand Logo Header Styling matching proportions */
  .brand-logo-block {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    text-decoration: none !important;
  }

  .brand-logo {
    height: 40px !important;
    width: auto !important;
    max-height: 44px !important;
    object-fit: contain !important;
    display: block !important;
    transition: transform 0.2s ease;
  }

  .brand-logo-block:hover .brand-logo {
    transform: scale(1.03);
  }

  .nav-button-block {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
  }

  /* Symmetrical, elegant rounded-rectangle CTA buttons override */
  .nav-button-block .primary-button,
  .nav-menu .primary-button {
    height: 48px !important; /* Taller for double lines */
    padding: 0 20px !important;
    border-radius: 10px !important; /* Symmetrical rounded corners matching cards */
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
    box-sizing: border-box !important;
    border: 1.5px solid transparent !important;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
    min-width: 140px !important;
    text-align: center !important;
  }

  /* Double line layout inside CTA buttons */
  .btn-double-line {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    line-height: 1.2 !important;
  }

  .btn-double-line .line-1 {
    font-size: 11px !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    display: block !important;
  }

  .btn-double-line .line-2 {
    font-size: 9.5px !important;
    font-weight: 600 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.5px !important;
    opacity: 0.8;
    margin-top: 2px !important;
    display: block !important;
  }

  /* Button 1 (Vender): Light Blue Transparent with solid border */
  .nav-button-block .general-button-block.is-2 .primary-button,
  .nav-menu .general-button-block.is-1 .primary-button {
    background-color: rgba(22, 92, 253, 0.08) !important;
    color: #0043ff !important;
    border-color: #0043ff !important;
  }

  .nav-button-block .general-button-block.is-2 .primary-button:hover,
  .nav-menu .general-button-block.is-1 .primary-button:hover {
    background-color: #0043ff !important;
    color: #ffffff !important;
    transform: translateY(-1.5px);
    box-shadow: 0 6px 16px rgba(22, 92, 253, 0.15) !important;
  }

  /* Button 2 (Ser Agente): Light Burgundy Transparent with solid border */
  .nav-button-block .general-button-block.is-2-agent .primary-button,
  .nav-menu .general-button-block.is-1-agent .primary-button {
    background-color: rgba(190, 18, 60, 0.08) !important;
    color: #ff1200 !important;
    border-color: #ff1200 !important;
  }

  .nav-button-block .general-button-block.is-2-agent .primary-button:hover,
  .nav-menu .general-button-block.is-1-agent .primary-button:hover {
    background-color: #ff1200 !important;
    color: #ffffff !important;
    transform: translateY(-1.5px);
    box-shadow: 0 6px 16px rgba(190, 18, 60, 0.15) !important;
  }

  .general-button-block.is-2-agent {
    display: flex;
    align-items: center;
  }

  .general-button-block.is-1-agent {
    display: none;
  }

  @media screen and (max-width: 991px) {
    .nav-button-block {
      gap: 6px !important;
    }
    .general-button-block.is-2-agent {
      display: none !important;
    }
    .general-button-block.is-1-agent {
      display: flex !important;
      justify-content: center;
      align-items: center;
      margin-top: 10px;
    }

    .nav-menu .primary-button {
      width: 100% !important;
      max-width: 280px !important;
    }
  }

  .custom-dropdown-container {
    position: relative;
    display: inline-block;
  }

  .custom-dropdown-toggle {
    background: none;
    border: none;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    text-transform: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 100%;
    color: var(--_colors---body-text-color) !important;
  }

  .custom-dropdown-toggle:hover {
    color: #0043ff !important;
  }

  .dropdown-arrow-icon {
    transition: transform 0.2s ease-in-out;
    stroke: currentColor;
  }

  .custom-dropdown-container:hover .dropdown-arrow-icon,
  .custom-dropdown-container.is-active .dropdown-arrow-icon {
    transform: rotate(180deg);
  }

  /* Dropdown Menu Container */
  .custom-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    transform: translateY(15px);
    width: 290px;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.12);
    padding: 10px;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: top left;
  }

  /* Transparent hover bridge to keep dropdown open when crossing the gap */
  .custom-dropdown-menu::before {
    content: "";
    position: absolute;
    top: -24px;
    left: 0;
    right: 0;
    height: 30px;
    background: transparent;
    z-index: -1;
  }

  .custom-dropdown-container:hover .custom-dropdown-menu,
  .custom-dropdown-container.is-active .custom-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(6px);
  }

  .custom-dropdown-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .custom-dropdown-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 16px;
    color: #334155 !important;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    border-radius: 10px;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    text-transform: none !important;
  }

  .custom-dropdown-link:hover {
    background-color: #f1f5f9;
    color: #0043ff !important;
    transform: translateX(4px);
  }

  .custom-dropdown-link svg {
    color: #64748b;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
    flex-shrink: 0;
  }

  .custom-dropdown-link:hover svg {
    color: #0043ff;
    transform: scale(1.08);
  }

  /* Highlighted link style */
  .custom-dropdown-link.seller {
    background-color: #f7f5ee;
    color: #ff1200 !important;
    border: 1px dashed rgba(225, 29, 72, 0.25);
    margin-top: 6px;
  }

  .nav-top-block {
    background-color: #000e35 !important;
  }

  .nav-top-content-block .paragraph-xsmall {
    font-family: 'Outfit', sans-serif !important;
    font-weight: 500;
  }

  .nav-link, .custom-dropdown-toggle {
    font-family: 'Outfit', sans-serif !important;
    font-weight: 600;
  }

  .custom-dropdown-link.seller:hover {
    background-color: #f7f5ee;
    color: #ff1200 !important;
    border-color: rgba(225, 29, 72, 0.4);
  }

  .custom-dropdown-link.seller svg {
    color: #ff1200;
  }

  @media (max-width: 991px) {
    .nav-menu-content.is-open {
      display: block !important;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: #ffffff;
      padding: 20px;
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
      border-bottom: 2px solid #f1f5f9;
    }

    .custom-dropdown-container {
      display: block;
      width: 100%;
    }

    .custom-dropdown-menu {
      position: static;
      transform: none !important;
      box-shadow: none;
      border: none;
      background-color: #f7f5ee;
      width: 100%;
      display: none;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      padding: 6px 12px;
      margin-top: 6px;
    }

    .custom-dropdown-container.is-active .custom-dropdown-menu {
      display: block;
    }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const mobileBtn = document.getElementById("mobileMenuBtn");
    const navMenu = document.getElementById("navMenu");
    const dropdownBtn = document.getElementById("inmueblesDropdownBtn");
    const dropdownContainer = dropdownBtn
      ? dropdownBtn.closest(".custom-dropdown-container")
      : null;

    if (mobileBtn && navMenu) {
      mobileBtn.addEventListener("click", () => {
        navMenu.classList.toggle("is-open");
      });
    }

    if (dropdownBtn && dropdownContainer) {
      dropdownBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        dropdownContainer.classList.toggle("is-active");
      });

      document.addEventListener("click", (e) => {
        if (!dropdownContainer.contains(e.target)) {
          dropdownContainer.classList.remove("is-active");
        }
      });
    }
  });
</script>
