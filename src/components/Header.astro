              <a href="/noticias" class="nav-link w-nav-link">Noticias</a>

              <!-- Button CTA Vender -->
              <div class="general-button-block is-1">
                <a href="/vender" class="primary-button w-inline-block">
                  <div class="btn-double-line">
                    <span class="line-1">¿Quieres Vender?</span>
