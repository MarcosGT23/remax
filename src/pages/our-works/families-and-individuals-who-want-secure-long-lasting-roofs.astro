---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Case Study - Secure Long-Lasting Roofs" description="Detailed case study on residential metal roof installation for families seeking long-lasting safety.">
  <Header />

  <main class="main-wrapper">
    <section class="section_hero_sub" style="padding: 80px 0 40px 0; background: #fff; border-bottom: 1px solid #e5e7eb;">
      <div class="w-layout-blockcontainer container-main w-container">
        <a href="/our-work" style="color: #0043ff; text-decoration: none; font-weight: 600; font-size: 14px;">&larr; Back to Portfolio</a>
        <h1 class="heading-style-1" style="margin-top: 16px; margin-bottom: 16px;">Families and Individuals Who Want Secure Long-Lasting Roofs</h1>
        <p class="paragraph-small">Case Study: Residential Roofing System Upgrade</p>
      </div>
    </section>

    <section style="padding: 60px 0;">
      <div class="w-layout-blockcontainer container-main w-container">
        <div style="background: #fff; padding: 40px; border-radius: 12px; border: 1px solid #e5e7eb; margin-bottom: 40px;">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px; padding-bottom: 32px; border-bottom: 1px solid #e5e7eb; margin-bottom: 32px;">
            <div>
              <div style="color: #6b7280; font-size: 14px;">Client Type</div>
              <div style="font-weight: 700; color: #000e35; font-size: 18px;">Residential Homeowner</div>
            </div>
            <div>
              <div style="color: #6b7280; font-size: 14px;">Service Provided</div>
              <div style="font-weight: 700; color: #000e35; font-size: 18px;">Metal Roof Installation</div>
            </div>
            <div>
              <div style="color: #6b7280; font-size: 14px;">Completion Time</div>
              <div style="font-weight: 700; color: #000e35; font-size: 18px;">3 Days</div>
            </div>
            <div>
              <div style="color: #6b7280; font-size: 14px;">Warranty</div>
              <div style="font-weight: 700; color: #000e35; font-size: 18px;">50-Year Limited Warranty</div>
            </div>
          </div>

          <h2 class="heading-style-3" style="margin-bottom: 16px;">Project Challenge</h2>
          <p class="paragraph-small" style="margin-bottom: 24px;">
            The original 20-year-old asphalt roof was suffering from severe shingle curling, granular loss, and recurring ridge vent leaks during storm seasons. The homeowner wanted a permanent solution that would eliminate future roof replacement costs and withstand hurricane-force winds.
          </p>

          <h2 class="heading-style-3" style="margin-bottom: 16px;">The RoofPro Solution</h2>
          <p class="paragraph-small" style="margin-bottom: 24px;">
            Our team performed a complete tear-off down to the plywood deck, replaced damaged decking panels, installed high-temperature synthetic underlayment, and engineered a custom 24-gauge standing seam metal roof in Matte Charcoal.
          </p>

          <div style="background: #f7f5ee; padding: 24px; border-radius: 8px; margin-top: 32px;">
            <h4 class="heading-style-5" style="margin-bottom: 8px;">Client Feedback</h4>
            <p class="paragraph-small" style="font-style: italic;">
              "RoofPro transformed our house. Not only does the new metal roof look incredible, but we saved 18% on our summer cooling bill right away!"
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
