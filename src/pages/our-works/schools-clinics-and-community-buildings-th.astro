---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Case Study - Schools, Clinics & Community Buildings" description="Case study on institutional roofing for community clinics and school facilities.">
  <Header />

  <main class="main-wrapper">
    <section class="section_breadcrumb service-details is-2" style="background-image: url('/images/6a5717b9f45479999f4faa06_our-work-thumbnail-5.jpg'); background-size: cover; background-position: 50%;">
      <div class="section-gap is-relative">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="breadcrumb-wrapper">
            <div class="breadcrumb-link-block">
              <a href="/our-work" class="link-button text-color-white w-inline-block">
                <div class="link-button-icon w-embed">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19 12H5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M12 5L5 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
                <div class="button-text">Back to Portfolio</div>
              </a>
            </div>
            <div class="breadcrumb-content-block is-3">
              <div class="breadcrumb-heading-block">
                <div class="breadcrumb-subtitle-block">
                  <div class="breadcrumb-subtitle">Work Details</div>
                </div>
                <div class="breadcrumb-title-block">
                  <h1 class="heading-style-2 text-color-white">Schools, clinics, and community buildings</h1>
                </div>
              </div>
              <div class="breadcrumb-summary-block max-width-640">
                <p class="paragraph-small text-color-white">Commercial districts where offices, clinics, and community spaces depend on long-lasting weather protection.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="breadcrumb-bg-overlay"></div>
    </section>

    <section class="section_overview">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="overview-wrapper">
            <div class="overview-content-block">
              <div class="section-title-block">
                <h2 class="heading-style-2">Case Study Overview</h2>
              </div>
              <div class="section-summary-block top-space-lg">
                <p class="paragraph-small">Community buildings and health clinics demand maximum indoor air quality, thermal insulation, and total water protection. Our certified team replaced over 2,500m² of legacy roofing with heavy-duty acoustic and thermal insulation roofing systems.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section_cta-two">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="cta-two-wrapper">
            <div class="cta-two-content-block">
              <div class="cta-title-block max-width-380 mobile-full"><h2 class="heading-style-2 text-color-white">Have an Institutional <span class="heading-style-2-wht">Project?</span></h2></div>
              <div class="cta-summary-block"><p class="paragraph-small text-color-white _80">Contact our commercial specialists today for a free estimate.</p></div>
            </div>
            <div class="cta-two-button-block">
              <a href="/contact" class="white-button is-2 w-inline-block">
                <div class="button-text-block varient-3">
                  <div class="button-text is-1 varient-4">Get Free Quote</div>
                  <div class="button-text is-2 varient-5">Get Free Quote</div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
