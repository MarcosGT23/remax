---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page Not Found || Roofing Services Website Template">
  <Header />

  <main class="main-wrapper">
    <section class="section_breadcrumb">
      <div class="section-gap hero">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="breadcrumb-wrapper" style="text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 400px;">
            <div style="font-size: 110px; font-weight: 800; color: #165cfd; line-height: 1; margin-bottom: 16px;">404</div>
            <h1 class="heading-style-2 text-color-white" style="margin-bottom: 16px;">Page Not Found</h1>
            <p class="paragraph-small text-color-white" style="max-width: 480px; margin-bottom: 32px;">
              The page you are looking for doesn't exist or has been moved.
            </p>
            <a href="/" class="primary-button w-inline-block">
              <div class="button-text-block">
                <div class="button-text is-1">Back to Home</div>
                <div class="button-text is-2">Back to Home</div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
