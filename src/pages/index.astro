                                  stroke-linejoin="round"></path>
                              </g>
                              <defs>
                                <clipPath id="clip0_152_190">
                                  <rect
                                    width="32"
                                    height="32"
                                    fill="currentColor"></rect>
                                </clipPath>
                              </defs>
                            </svg>
                          </div>
