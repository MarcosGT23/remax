---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FaqSection from "../components/FaqSection.astro";

const oficinasLogos = [
  { name: "RE/MAX Agrourbano", src: "/images/oficinas/agrourbano.png" },
  { name: "RE/MAX At Work", src: "/images/oficinas/at_work.png" },
  { name: "RE/MAX Black", src: "/images/oficinas/black.png" },
  { name: "RE/MAX Bussine", src: "/images/oficinas/bussine.png" },
  { name: "RE/MAX Capital", src: "/images/oficinas/capital.png" },
  { name: "RE/MAX Elite", src: "/images/oficinas/elite.png" },
  { name: "RE/MAX Emporio", src: "/images/oficinas/emporio.png" },
  { name: "RE/MAX Emprende", src: "/images/oficinas/emprende.png" },
  { name: "RE/MAX Essential", src: "/images/oficinas/essential.png" },
  { name: "RE/MAX Express", src: "/images/oficinas/express.png" },
  { name: "RE/MAX Fortaleza", src: "/images/oficinas/fortaleza.png" },
  { name: "RE/MAX Futuro", src: "/images/oficinas/futuro.png" },
  { name: "RE/MAX Impacto", src: "/images/oficinas/impacto1.png" },
  {
    name: "RE/MAX Impacto Rise",
    src: "/images/oficinas/impacto_rise_black.png",
  },
  { name: "RE/MAX Infinity", src: "/images/oficinas/infinity.png" },
  { name: "RE/MAX Inversiones", src: "/images/oficinas/inversiones.png" },
  { name: "RE/MAX Legacy", src: "/images/oficinas/legacy.png" },
  { name: "RE/MAX Magna", src: "/images/oficinas/magna.png" },
  { name: "RE/MAX Norte", src: "/images/oficinas/norte.png" },
  { name: "RE/MAX Nova", src: "/images/oficinas/nova.png" },
  { name: "RE/MAX Origen", src: "/images/oficinas/origen.png" },
  { name: "RE/MAX Patrimonio", src: "/images/oficinas/patrimonio.png" },
  { name: "RE/MAX Plus", src: "/images/oficinas/plus.png" },
  { name: "RE/MAX Premier", src: "/images/oficinas/premier.png" },
  { name: "RE/MAX Premium", src: "/images/oficinas/premium.png" },
  { name: "RE/MAX Rural", src: "/images/oficinas/rural.png" },
  { name: "RE/MAX Unión", src: "/images/oficinas/union.png" },
