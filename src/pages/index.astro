---

<Layout
  title="RE/MAX Bolivia | Tu Red Inmobiliaria de Confianza"
  description="Encuentra propiedades en Venta, Alquiler y Anticrético en Bolivia. Casas, departamentos, terrenos y locales comerciales con el respaldo de la red número uno del mundo."
>
  <Header />

  <main class="main-wrapper">
    <!-- HERO SECTION -->
    <section class="section_hero">
      <div class="section-gap hero">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="hero-wrapper">
            <div class="hero-content-block">
              <div class="hero-text-block">
                <div class="hero-title-block">
                  <h1 class="heading-style-1">
                    Encuentra la Propiedad de tus Sueños
                  </h1>
                </div>
                <div class="hero-summary-block">
                  <p class="paragraph-small">
                    La red inmobiliaria más grande del mundo a tu servicio.
                    Casas, departamentos, terrenos y locales comerciales en
                    venta, alquiler y anticrético en toda Bolivia.
                  </p>
                </div>
                <div class="hero-button-block">
                  <a
                    data-wf--primary-button--variant="variant-1"
                    href="/inmuebles"
                    class="primary-button w-inline-block"
                  >
                    <div class="button-text-block">
                      <div class="button-text is-1">Buscar Inmuebles</div>
                      <div class="button-text is-2">Buscar Inmuebles</div>
                    </div>
                  </a>
                  <a
                    data-wf--secondary-button--variant="varient-1"
                    href="/vender"
                    class="secondary-button w-inline-block"
                  >
                    <div class="button-text-block">
                      <div class="button-text is-1">¿Quieres Vender?</div>
                      <div class="button-text is-2">Consignar Propiedad</div>
                    </div>
                    <div class="button-icon-block">
                      <div class="button-icon is-1 w-embed">
                        <svg
                          width="22"
                          height="22"
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <g clip-path="url(#clip0_4113_220)">
                            <path
                              d="M17 6.99951L7 16.9995"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"></path>
                            <path
                              d="M8 6.99951H17V15.9995"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"></path>
                          </g>
                          <defs>
                            <clipPath id="clip0_4113_220">
                              <rect
                                width="24"
                                height="24"
                                fill="currentColor"
                                transform="matrix(-1 0 0 1 24 0)"></rect>
                            </clipPath>
                          </defs>
                        </svg>
                      </div>
                      <div class="button-icon is-2 w-embed">
                        <svg
                          width="22"
                          height="22"
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <g clip-path="url(#clip0_4113_220)">
                            <path
                              d="M17 6.99951L7 16.9995"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"></path>
                            <path
                              d="M8 6.99951H17V15.9995"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"></path>
                          </g>
                          <defs>
                            <clipPath id="clip0_4113_220">
                              <rect
                                width="24"
                                height="24"
                                fill="currentColor"
                                transform="matrix(-1 0 0 1 24 0)"></rect>
                            </clipPath>
                          </defs>
                        </svg>
                      </div>
                    </div>
                  </a>
                </div>
                <div class="hero-rating-block">
                  <div class="hero-rating-avatar-block">
                    <img
                      src="/images/avatar-01_1avatar-01.png"
                      loading="lazy"
                      data-w-id="bba29235-7894-645a-f58b-800ebbf8163f"
                      alt="hero-rating-avatar"
                      class="hero-rating-avatar is-1"
                    />
                    <img
                      src="/images/avatar-02_1avatar-02.png"
                      loading="lazy"
                      data-w-id="86ab84a2-50e5-770d-7528-a3ed66775a60"
                      alt="hero-rating-avatar"
                      class="hero-rating-avatar"
                    />
                    <img
                      src="/images/avatar-03_1avatar-03.png"
                      loading="lazy"
                      data-w-id="e92836f1-7e70-77a7-642d-811e892ce3d3"
                      alt="hero-rating-avatar"
                      class="hero-rating-avatar"
                    />
                  </div>
                  <div
                    data-w-id="0003ea8e-4c4d-aea0-f7e3-022c6494bd7d"
                    class="hero-rating-info-block"
                  >
                    <div class="hero-rating-star-block">
                      <img
                        src="/images/Star-Icon.svg"
                        loading="lazy"
                        alt="hero-rating-star"
                        class="hero-rating-star"
                      />
                      <img
                        src="/images/Star-Icon.svg"
                        loading="lazy"
                        alt="hero-rating-star"
                        class="hero-rating-star"
                      />
                      <img
                        src="/images/Star-Icon.svg"
                        loading="lazy"
                        alt="hero-rating-star"
                        class="hero-rating-star"
                      />
                      <img
                        src="/images/Star-Icon.svg"
                        loading="lazy"
                        alt="hero-rating-star"
                        class="hero-rating-star"
                      />
                      <img
                        src="/images/Star-Icon.svg"
                        loading="lazy"
                        alt="hero-rating-star"
                        class="hero-rating-star"
                      />
                    </div>
                    <p class="paragraph-xxsmall text-color-title-color">
                      Rated 4.9/5 from 1200+ reviews
                    </p>
                  </div>
                </div>
              </div>
              <div class="hero-image-block">
                <img
                  class="hero-image"
                  src="/images/recursos/recursos-2.png"
                  alt="hero-image"
                  data-w-id="fa253f3b-bffc-1529-2c0a-22b66679330b"
                  loading="lazy"
                />
                <div
                  data-w-id="781d5bbf-4ec7-8035-2836-dd3b2aa9c813"
                  class="hero-image-overlay"
                >
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BRANDS LOGO SECTION -->
    <section class="section_logo">
      <div class="section-gap top-lg">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="logo-wrapper">
            <div class="section-heading-block center-align">
              <div class="section-title-block">
                <div class="label-large text-align-center">
                  Oficinas Santa Cruz
                </div>
              </div>
            </div>
            <div
              data-w-id="c63ebb52-0317-ce7d-c699-ec206859a84d"
              class="logo-content-block"
            >
              <div class="sponsor-logo-row">
                {
                  oficinasLogos.map((office) => (
                    <img
                      src={office.src}
                      loading="lazy"
                      alt={office.name}
                      title={office.name}
                      class="sponsor-logo"
                    />
                  ))
                }
              </div>
              <div class="sponsor-logo-row" aria-hidden="true">
                {
                  oficinasLogos.map((office) => (
                    <img
                      src={office.src}
                      loading="lazy"
                      alt={office.name}
                      title={office.name}
                      class="sponsor-logo"
                    />
                  ))
                }
              </div>
              <div class="logo-overlay-block"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

