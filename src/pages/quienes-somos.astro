---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
---

<Layout
  title="¿Quiénes Somos? | RE/MAX Bolivia"
  description="Conoce más sobre RE/MAX, líderes globales y locales en servicios inmobiliarios, compra, venta, alquiler y anticrético en Bolivia."
>
  <Header />

  <main class="main-wrapper">
    <PageHeader
      badge="Sobre Nosotros"
      title="Transformando la experiencia inmobiliaria en Bolivia"
      backLink="/"
    />

    <!-- Company Overview -->
    <section class="section_our-story" style="padding: 80px 0;">
      <div class="w-layout-blockcontainer container-main w-container">
        <div
          style="display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;"
        >
          <div>
            <span
              style="color: #0052cc; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;"
              >Líderes Mundiales</span
            >
            <h2
              style="font-size: 2.2rem; font-weight: 800; margin: 12px 0 24px; color: #0d111a;"
            >
              Tu red inmobiliaria de máxima confianza
            </h2>
            <p
              style="font-size: 1.1rem; line-height: 1.7; color: #4a5568; margin-bottom: 20px;"
            >
              En RE/MAX nos apasiona conectar a las personas con la propiedad de
              sus sueños. Con una red global presente en más de 110 países y la
              oficina con mayor crecimiento en Bolivia, ofrecemos asesoramiento
              integral en ventas, alquileres y operaciones de anticrético.
            </p>
            <p
              style="font-size: 1.05rem; line-height: 1.7; color: #4a5568; margin-bottom: 28px;"
            >
              Nuestro equipo de agentes altamente capacitados combina tecnología
              de vanguardia, inteligencia de mercado local y un estándar ético
              inquebrantable para lograr los mejores resultados para cada
              propietario y comprador.
            </p>

            <div style="display: flex; gap: 24px;">
              <a
                href="/inmuebles"
                class="primary-button w-inline-block"
                style="background: #0052cc; color: white; padding: 14px 28px; border-radius: 8px; font-weight: 700; text-decoration: none;"
                >Explorar Inmuebles</a
              >
              <a
                href="/vender"
                class="secondary-button w-inline-block"
                style="border: 2px solid #0052cc; color: #0052cc; padding: 14px 28px; border-radius: 8px; font-weight: 700; text-decoration: none;"
                >Publicar mi Propiedad</a
              >
            </div>
          </div>
          <div style="position: relative;">
            <img
              src="/images/logo/remax-black.png"
              alt="RE/MAX Equipo"
              style="width: 100%; border-radius: 16px; drop-shadow: 0 20px 40px rgba(0,0,0,0.15);"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Cream Minimalist Stats Section with Animated Counters -->
    <section class="minimal-stats-section">
      <div class="w-layout-blockcontainer container-main w-container">
        <div class="minimal-stats-grid">
          <div class="stat-item" data-target="1500" data-prefix="+" data-suffix="">
            <div class="stat-number-wrapper">
              <span class="stat-number">+0</span>
            </div>
            <div class="stat-indicator"></div>
            <div class="stat-label">Propiedades Vendidas & Alquiladas</div>
          </div>

          <div class="stat-item" data-target="50" data-prefix="+" data-suffix="">
            <div class="stat-number-wrapper">
              <span class="stat-number">+0</span>
            </div>
            <div class="stat-indicator"></div>
            <div class="stat-label">Agentes Certificados</div>
          </div>

          <div class="stat-item" data-target="98" data-prefix="" data-suffix="%">
            <div class="stat-number-wrapper">
              <span class="stat-number">0%</span>
            </div>
            <div class="stat-indicator"></div>
            <div class="stat-label">Clientes Satisfechos</div>
          </div>

          <div class="stat-item" data-target="10" data-prefix="" data-suffix="+">
            <div class="stat-number-wrapper">
              <span class="stat-number">0+</span>
            </div>
            <div class="stat-indicator"></div>
            <div class="stat-label">Años de Experiencia en el Mercado</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission & Vision -->
    <section style="padding: 80px 0; background-color: #f8fafc;">
      <div class="w-layout-blockcontainer container-main w-container">
        <div style="text-align: center; max-width: 700px; margin: 0 auto 56px;">
          <h2 style="font-size: 2.2rem; font-weight: 800; color: #0d111a;">
            Nuestros Principios y Compromiso
          </h2>
          <p style="color: #64748b; font-size: 1.1rem; margin-top: 12px;">
            Trabajamos día a día con valores sólidos para brindar una
            transacción transparente y segura.
          </p>
        </div>

        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;"
        >
          <div
            style="background: white; padding: 36px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);"
          >
            <div
              style="width: 56px; height: 56px; background: #e0e7ff; color: #4338ca; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;"
            >
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                ></path></svg
              >
            </div>
            <h3
              style="font-size: 1.4rem; font-weight: 700; margin-bottom: 12px; color: #0d111a;"
            >
              Misión
            </h3>
            <p style="color: #475569; line-height: 1.6;">
              Proporcionar soluciones inmobiliarias eficientes, seguras y de
              alto valor mediante agentes capacitados que cuidan cada detalle
              legal y comercial del proceso.
            </p>
          </div>

          <div
            style="background: white; padding: 36px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);"
          >
            <div
              style="width: 56px; height: 56px; background: #fee2e2; color: #dc2626; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;"
            >
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"
                ></path><path d="M12 8h.01"></path></svg
              >
            </div>
            <h3
              style="font-size: 1.4rem; font-weight: 700; margin-bottom: 12px; color: #0d111a;"
            >
              Visión
            </h3>
            <p style="color: #475569; line-height: 1.6;">
              Ser la empresa inmobiliaria referente y más recomendada del país,
              reconocida por su excelencia operativa y ética profesional.
            </p>
          </div>

          <div
            style="background: white; padding: 36px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.05);"
          >
            <div
              style="width: 56px; height: 56px; background: #dcfce7; color: #15803d; border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;"
            >
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline
                  points="22 4 12 14.01 9 11.01"></polyline></svg
              >
            </div>
            <h3
              style="font-size: 1.4rem; font-weight: 700; margin-bottom: 12px; color: #0d111a;"
            >
              Valores
            </h3>
            <p style="color: #475569; line-height: 1.6;">
              Transparencia, compromiso con el cliente, constante capacitación e
              innovación en estrategias de promoción de propiedades.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const statItems = document.querySelectorAll('.stat-item');
    if (!statItems.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');

          const numberEl = entry.target.querySelector('.stat-number');
          const target = parseInt(entry.target.getAttribute('data-target') || '0', 10);
          const prefix = entry.target.getAttribute('data-prefix') || '';
          const suffix = entry.target.getAttribute('data-suffix') || '';

          if (numberEl && !entry.target.dataset.animated) {
            entry.target.dataset.animated = 'true';
            const duration = 1800; // 1.8 seconds
            const startTime = performance.now();

            function updateCounter(currentTime) {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              // Ease-out cubic formula for smooth slowdown at the end
              const easeOut = 1 - Math.pow(1 - progress, 3);
              const currentVal = Math.floor(easeOut * target);

              const formattedVal = currentVal.toLocaleString('en-US');
              numberEl.textContent = `${prefix}${formattedVal}${suffix}`;

              if (progress < 1) {
                requestAnimationFrame(updateCounter);
              } else {
                numberEl.textContent = `${prefix}${target.toLocaleString('en-US')}${suffix}`;
              }
            }

            requestAnimationFrame(updateCounter);
          }
        }
      });
    }, { threshold: 0.15 });

    statItems.forEach((item) => observer.observe(item));
  });
</script>

<style>
  /* Cream Minimalist Animated Stats Section */
  .minimal-stats-section {
    background-color: #f7f5f0; /* Warm elegant cream tone */
    padding: 68px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    position: relative;
  }

  .minimal-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
  }

  .stat-item {
    padding: 20px 24px;
    text-align: center;
    border-right: 1px solid rgba(0, 0, 0, 0.07);
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stat-item:last-child {
    border-right: none;
  }

  .stat-item.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger delays for entrance */
  .stat-item:nth-child(1) { transition-delay: 0.1s; }
  .stat-item:nth-child(2) { transition-delay: 0.2s; }
  .stat-item:nth-child(3) { transition-delay: 0.3s; }
  .stat-item:nth-child(4) { transition-delay: 0.4s; }

  .stat-item:hover {
    transform: translateY(-4px);
  }

  .stat-number-wrapper {
    display: inline-block;
  }

  .stat-number {
    font-size: 3.3rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -1.5px;
    color: #0f172a; /* Executive dark navy/slate */
    margin-bottom: 6px;
    display: block;
    font-feature-settings: "tnum";
    transition: color 0.3s ease;
  }

  .stat-item:hover .stat-number {
    color: #165cfd; /* RE/MAX Accent blue on hover */
  }

  .stat-indicator {
    width: 24px;
    height: 3px;
    background-color: #165cfd;
    margin: 10px auto 14px auto;
    border-radius: 2px;
    opacity: 0.35;
    transform: scaleX(0.6);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stat-item:hover .stat-indicator {
    opacity: 1;
    transform: scaleX(1.4);
    background-color: #be123c; /* RE/MAX Crimson accent on hover */
  }

  .stat-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: #52525b; /* Warm dark gray */
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.45;
    max-width: 210px;
    margin: 0 auto;
  }

  @media (max-width: 991px) {
    .minimal-stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 36px 0;
    }
    .stat-item {
      border-right: none;
    }
    .stat-item:nth-child(odd) {
      border-right: 1px solid rgba(0, 0, 0, 0.07);
    }
  }

  @media (max-width: 576px) {
    .minimal-stats-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .stat-item {
      border-right: none !important;
      padding: 0;
    }
  }
</style>
