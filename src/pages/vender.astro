---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout title="¿Quieres Vender tu Propiedad? | RE/MAX Bolivia" description="Publica tu casa, departamento o terreno con RE/MAX. Llena el formulario y nuestros agentes se pondrán en contacto contigo para una valoración sin compromiso.">
  <Header />

  <main class="main-wrapper">
    <PageHeader
      badge="Consigna tu Propiedad"
      title="¿Quieres Vender, Alquilar o dar en Anticrético tu Inmueble?"
      subtitle="Vende al mejor precio del mercado con el respaldo de la red inmobiliaria número uno de Bolivia. Completa los datos a continuación y un agente calificado evaluará tu propiedad sin compromiso."
      backLink="/"
    />

    <!-- Form & Benefits Section -->
    <section style="padding: 70px 0 90px; background-color: #f7f5ee;">
      <div class="w-layout-blockcontainer container-main w-container">
        <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 48px; align-items: start;">
          
          <!-- Benefits Column -->
          <div style="background: white; padding: 36px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0;">
            <h3 style="font-size: 1.4rem; font-weight: 800; color: #000e35; margin-bottom: 24px;">¿Por qué vender con RE/MAX?</h3>
            
            <div style="display: flex; flex-direction: column; gap: 24px;">
              <div style="display: flex; gap: 16px;">
                <div style="width: 44px; height: 44px; background: #f7f5ee; color: #0043ff; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8l-8 8"/><path d="M12 16l4-4"/></svg>
                </div>
                <div>
                  <h4 style="font-size: 1.05rem; font-weight: 700; color: #000e35; margin-bottom: 4px;">Máxima Difusión</h4>
                  <p style="font-size: 0.9rem; color: #64748b; line-height: 1.5;">Publicamos tu propiedad en portales nacionales e internacionales, redes sociales y nuestra red interna de agentes.</p>
                </div>
              </div>

              <div style="display: flex; gap: 16px;">
                <div style="width: 44px; height: 44px; background: #f7f5ee; color: #ff1200; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div>
                  <h4 style="font-size: 1.05rem; font-weight: 700; color: #000e35; margin-bottom: 4px;">Valoración Comercial Real</h4>
                  <p style="font-size: 0.9rem; color: #64748b; line-height: 1.5;">Analizamos los precios reales de mercado para garantizar que fijes el precio óptimo y evites perder dinero.</p>
                </div>
              </div>

              <div style="display: flex; gap: 16px;">
                <div style="width: 44px; height: 44px; background: #ecfdf5; color: #059669; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <div>
                  <h4 style="font-size: 1.05rem; font-weight: 700; color: #000e35; margin-bottom: 4px;">Asesoría Legal Integral</h4>
                  <p style="font-size: 0.9rem; color: #64748b; line-height: 1.5;">Revisamos documentación, contratos de minuta, impuestos y trámites notariales para tu seguridad.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Listing Submission Form -->
          <div style="background: white; padding: 40px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.06); border: 1px solid #e2e8f0;">
            <h3 style="font-size: 1.6rem; font-weight: 800; color: #000e35; margin-bottom: 8px;">Formulario de Registro de Propiedad</h3>
            <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 32px;">Completa la información sobre ti y tu propiedad. Nos pondremos en contacto en menos de 24 horas.</p>

            <form id="venderForm" onsubmit="event.preventDefault(); document.getElementById('successMsg').style.display='block'; this.reset();">
              
              <!-- Owner Info -->
              <div style="margin-bottom: 28px;">
                <h4 style="font-size: 1.1rem; font-weight: 700; color: #0043ff; margin-bottom: 16px; border-bottom: 2px solid #e0e7ff; padding-bottom: 8px;">1. Datos de Contacto del Propietario</h4>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                  <div>
                    <label style="display: block; font-weight: 600; font-size: 0.9rem; color: #334155; margin-bottom: 6px;">Nombre Completo *</label>
                    <input type="text" required placeholder="Ej: Juan Pérez" style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none;" />
                  </div>
                  <div>
                    <label style="display: block; font-weight: 600; font-size: 0.9rem; color: #334155; margin-bottom: 6px;">Teléfono / WhatsApp *</label>
                    <input type="tel" required placeholder="Ej: 71234567" style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none;" />
                  </div>
                  <div>
                    <label style="display: block; font-weight: 600; font-size: 0.9rem; color: #334155; margin-bottom: 6px;">Correo Electrónico *</label>
                    <input type="email" required placeholder="juan@ejemplo.com" style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none;" />
                  </div>
                  <div>
                    <label style="display: block; font-weight: 600; font-size: 0.9rem; color: #334155; margin-bottom: 6px;">Ciudad *</label>
                    <select required style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none; background: white;">
                      <option value="">Selecciona tu ciudad</option>
                      <option value="Santa Cruz">Santa Cruz</option>
                      <option value="La Paz">La Paz</option>
                      <option value="Cochabamba">Cochabamba</option>
                      <option value="Tarija">Tarija</option>
                      <option value="Sucre">Sucre</option>
                      <option value="Otra">Otra</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Property Info -->
              <div style="margin-bottom: 28px;">
                <h4 style="font-size: 1.1rem; font-weight: 700; color: #0043ff; margin-bottom: 16px; border-bottom: 2px solid #e0e7ff; padding-bottom: 8px;">2. Detalles del Inmueble</h4>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                  <div>
                    <label style="display: block; font-weight: 600; font-size: 0.9rem; color: #334155; margin-bottom: 6px;">Modalidad de Operación *</label>
                    <select required style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none; background: white;">
                      <option value="venta">Deseo Vender</option>
                      <option value="alquiler">Deseo Alquilar</option>
                      <option value="anticretico">Deseo dar en Anticrético</option>
                    </select>
                  </div>
                  <div>
                    <label style="display: block; font-weight: 600; font-size: 0.9rem; color: #334155; margin-bottom: 6px;">Tipo de Propiedad *</label>
                    <select required style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none; background: white;">
                      <option value="casa">Casa / Chalet</option>
                      <option value="departamento">Departamento</option>
                      <option value="terreno">Terreno / Lote</option>
                      <option value="oficina">Oficina Comercial</option>
                      <option value="local">Local Comercial</option>
                      <option value="galpon">Galpón Industrial</option>
                    </select>
                  </div>
                  <div>
                    <label style="display: block; font-weight: 600; font-size: 0.9rem; color: #334155; margin-bottom: 6px;">Precio Pretendido ($us o Bs)</label>
                    <input type="text" placeholder="Ej: $us 150,000" style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none;" />
                  </div>
                  <div>
                    <label style="display: block; font-weight: 600; font-size: 0.9rem; color: #334155; margin-bottom: 6px;">Zona / Barrio / Dirección</label>
                    <input type="text" placeholder="Ej: Equipetrol, 4to Anillo" style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none;" />
                  </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-bottom: 20px;">
                  <div>
                    <label style="display: block; font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px;">Habitaciones</label>
                    <input type="number" min="0" placeholder="Ej: 3" style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none;" />
                  </div>
                  <div>
                    <label style="display: block; font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px;">Baños</label>
                    <input type="number" min="0" placeholder="Ej: 2" style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none;" />
                  </div>
                  <div>
                    <label style="display: block; font-weight: 600; font-size: 0.85rem; color: #334155; margin-bottom: 6px;">Superficie (m²)</label>
                    <input type="text" placeholder="Ej: 180 m²" style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none;" />
                  </div>
                </div>

                <div>
                  <label style="display: block; font-weight: 600; font-size: 0.9rem; color: #334155; margin-bottom: 6px;">Descripción Corta / Comentarios Adicionales</label>
                  <textarea rows="4" placeholder="Describe las características principales, estado de conservación, garaje, etc." style="width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.95rem; outline: none; font-family: inherit;"></textarea>
                </div>
              </div>

              <!-- Submit Button -->
              <button type="submit" style="width: 100%; background: #ff1200; color: white; border: none; padding: 16px; border-radius: 10px; font-weight: 800; font-size: 1.1rem; cursor: pointer; transition: background 0.2s ease;">
                Enviar Formulario de Propiedad
              </button>
            </form>

            <div id="successMsg" style="display: none; margin-top: 24px; padding: 20px; background: #dcfce7; border: 1px solid #86efac; color: #166534; border-radius: 10px; font-weight: 600; text-align: center;">
              🎉 ¡Gracias! Tu solicitud ha sido enviada exitosamente. Un agente RE/MAX se pondrá en contacto contigo a la brevedad.
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
