---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Industrial Roofing - RoofPro Services" description="Robust, safety-focused industrial roofing for manufacturing, warehouse, and heavy industrial facilities.">
  <Header />

  <main class="main-wrapper">
    <section class="section_breadcrumb service-details is-2" style="background-image: url('/images/6a5717b9f45479999f4faae5_service-card-three-image-1.jpg'); background-size: cover; background-position: 50%;">
      <div class="section-gap is-relative">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="breadcrumb-wrapper">
            <div class="breadcrumb-link-block">
              <a href="/services" class="link-button text-color-white w-inline-block">
                <div class="link-button-icon w-embed">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19 12H5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M12 5L5 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
                <div class="button-text">Back to Services</div>
              </a>
            </div>
            <div class="breadcrumb-content-block is-3">
              <div class="breadcrumb-heading-block">
                <div class="breadcrumb-subtitle-block">
                  <div class="breadcrumb-subtitle">Service Details</div>
                </div>
                <div class="breadcrumb-title-block">
                  <h1 class="heading-style-2 text-color-white">Industrial Roofing</h1>
                </div>
              </div>
              <div class="breadcrumb-summary-block max-width-640">
                <p class="paragraph-small text-color-white">Heavy-duty industrial roofing solutions built for extreme operational conditions and structural endurance.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="breadcrumb-bg-overlay"></div>
    </section>

    <section class="section_overview">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="overview-wrapper">
            <div class="overview-content-block">
              <div class="section-title-block">
                <h2 class="heading-style-2">Overview</h2>
              </div>
              <div class="section-summary-block top-space-lg">
                <p class="paragraph-small">Industrial facilities require heavy-duty weather proofing, high chemical resistance, and severe structural load capacity. Our team handles complex industrial roof installations, retrofits, and routine structural inspections across Brisbane.</p>
              </div>
            </div>
            <div class="overview-image-block is-2">
              <div class="overview-image-single-block is-1"><img src="/images/6a5717b9f45479999f4faae5_service-card-three-image-1.jpg" loading="lazy" alt="service-overview-image" class="service-overview-image"></div>
              <div class="overview-image-single-block is-2"><img src="/images/6a5717b9f45479999f4faae4_service-card-three-image-2.jpg" loading="lazy" alt="service-overview-image" class="service-overview-image"></div>
              <div class="overview-image-single-block is-3"><img src="/images/6a5717b9f45479999f4faad7_service-details-image-1.jpg" loading="lazy" alt="service-overview-image" class="service-overview-image"></div>
              <div class="overview-image-single-block is-4"><img src="/images/6a5717b9f45479999f4faad8_service-details-image-2.jpg" loading="lazy" alt="service-overview-image" class="service-overview-image"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section_cta-two">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="cta-two-wrapper">
            <div class="cta-two-content-block">
              <div class="cta-title-block max-width-380 mobile-full"><h2 class="heading-style-2 text-color-white">Ready to Get <span class="heading-style-2-wht">Started?</span></h2></div>
              <div class="cta-summary-block"><p class="paragraph-small text-color-white _80">Contact us today for a free industrial consultation.</p></div>
            </div>
            <div class="cta-two-button-block">
              <a href="/contact" class="white-button is-2 w-inline-block">
                <div class="button-text-block varient-3">
                  <div class="button-text is-1 varient-4">Get Quote</div>
                  <div class="button-text is-2 varient-5">Get Quote</div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
