---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Residential Roofing - RoofPro Services" description="Our roofing services are designed to deliver durable, long-lasting protection with minimal hassle. From inspections to installations.">
  <Header />

  <main class="main-wrapper">
    <section class="section_breadcrumb service-details is-2" style="background-image: url('/images/6a5717b9f45479999f4faaf1_Frame-6-1.jpg'); background-size: cover; background-position: 50%;">
      <div class="section-gap is-relative">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="breadcrumb-wrapper">
            <div class="breadcrumb-link-block">
              <a href="/services" class="link-button text-color-white w-inline-block">
                <div class="link-button-icon w-embed">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19 12H5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M12 5L5 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
                <div class="button-text">Back to Services</div>
              </a>
            </div>
            <div class="breadcrumb-content-block is-3">
              <div class="breadcrumb-heading-block">
                <div class="breadcrumb-subtitle-block">
                  <div class="breadcrumb-subtitle">Service Details</div>
                </div>
                <div class="breadcrumb-title-block">
                  <h1 class="heading-style-2 text-color-white">Residential Roofing</h1>
                </div>
              </div>
              <div class="breadcrumb-summary-block max-width-640">
                <p class="paragraph-small text-color-white">Our roofing services are designed to deliver durable, long-lasting protection with minimal hassle. From inspections to installations.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="breadcrumb-bg-overlay"></div>
    </section>

    <section class="section_overview">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="overview-wrapper">
            <div class="overview-content-block">
              <div class="section-title-block">
                <h2 class="heading-style-2">Overview</h2>
              </div>
              <div class="section-summary-block top-space-lg">
                <p class="paragraph-small">Our residential roofing services are designed to protect your most valuable asset—your home. With decades of experience and a commitment to quality, we provide comprehensive roofing solutions that enhance both the beauty and durability of your property. From modern new builds to heritage home restorations, we deliver exceptional results tailored to your specific needs.</p>
              </div>
            </div>
            <div class="overview-image-block is-2">
              <div class="overview-image-single-block is-1"><img src="/images/6a5717b9f45479999f4faad7_service-details-image-1.jpg" loading="lazy" alt="service-overview-image" class="service-overview-image"></div>
              <div class="overview-image-single-block is-2"><img src="/images/6a5717b9f45479999f4faad8_service-details-image-2.jpg" loading="lazy" alt="service-overview-image" class="service-overview-image"></div>
              <div class="overview-image-single-block is-3"><img src="/images/6a5717b9f45479999f4faad9_service-details-image-3.jpg" loading="lazy" alt="service-overview-image" class="service-overview-image"></div>
              <div class="overview-image-single-block is-4"><img src="/images/6a5717b9f45479999f4faada_service-details-image-4.jpg" loading="lazy" alt="service-overview-image" class="service-overview-image"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section_what-offer">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="what-offer-wrapper">
            <div class="section-heading-block bottom-space-between mobile-vflex">
              <div class="section-title-block max-width-210 mobile-fluid">
                <h2 class="heading-style-2">What <span class="heading-style-2-ht">We Offer</span></h2>
              </div>
              <div class="section-summary-block max-width-500 tab-top-space">
                <p class="paragraph-small">Comprehensive roofing solutions that combine cutting-edge technology with traditional craftsmanship</p>
              </div>
            </div>
            <div class="what-offer-content-block">
              <div class="what-offer-content-inner">
                <div class="what-offer-point-block">
                  <div class="what-offer-point-icon-block"><img src="/images/6a5717b9f45479999f4faadb_Service-Offer-Icon-1.svg" loading="lazy" alt="what-offer-point-icon" class="what-offer-point-icon"></div>
                  <div class="what-offer-point-text-block"><div class="label-medium">New roof installations for all home styles</div></div>
                </div>
                <div class="what-offer-point-block">
                  <div class="what-offer-point-icon-block"><img src="/images/6a5717b9f45479999f4faadc_Service-Offer-Icon-2.svg" loading="lazy" alt="what-offer-point-icon" class="what-offer-point-icon"></div>
                  <div class="what-offer-point-text-block"><div class="label-medium">Roof repairs and leak detection</div></div>
                </div>
                <div class="what-offer-point-block">
                  <div class="what-offer-point-icon-block"><img src="/images/6a5717b9f45479999f4faadd_Service-Offer-Icon-3.svg" loading="lazy" alt="what-offer-point-icon" class="what-offer-point-icon"></div>
                  <div class="what-offer-point-text-block"><div class="label-medium">Complete roof replacements</div></div>
                </div>
                <div class="what-offer-point-block">
                  <div class="what-offer-point-icon-block"><img src="/images/6a5717b9f45479999f4faade_Service-Offer-Icon-4.svg" loading="lazy" alt="what-offer-point-icon" class="what-offer-point-icon"></div>
                  <div class="what-offer-point-text-block"><div class="label-medium">Colorbond and metal roofing</div></div>
                </div>
                <div class="what-offer-point-block">
                  <div class="what-offer-point-icon-block"><img src="/images/6a5717b9f45479999f4faadf_Service-Offer-Icon-5.svg" loading="lazy" alt="what-offer-point-icon" class="what-offer-point-icon"></div>
                  <div class="what-offer-point-text-block small"><div class="label-medium">Tile and slate roofing</div></div>
                </div>
                <div class="what-offer-point-block">
                  <div class="what-offer-point-icon-block"><img src="/images/6a5717b9f45479999f4faae0_Service-Offer-Icon-6.svg" loading="lazy" alt="what-offer-point-icon" class="what-offer-point-icon"></div>
                  <div class="what-offer-point-text-block"><div class="label-medium">Gutter installation and replacement</div></div>
                </div>
                <div class="what-offer-point-block">
                  <div class="what-offer-point-icon-block"><img src="/images/6a5717b9f45479999f4faae1_Service-Offer-Icon-7.svg" loading="lazy" alt="what-offer-point-icon" class="what-offer-point-icon"></div>
                  <div class="what-offer-point-text-block"><div class="label-medium">Roof ventilation systems</div></div>
                </div>
                <div class="what-offer-point-block">
                  <div class="what-offer-point-icon-block"><img src="/images/6a5717b9f45479999f4faae2_Service-Offer-Icon-9.svg" loading="lazy" alt="what-offer-point-icon" class="what-offer-point-icon"></div>
                  <div class="what-offer-point-text-block small"><div class="label-medium">Skylight installation</div></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section_key-benefit">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="key-benefit-wrapper">
            <div class="section-heading-block bottom-space-between bottom-space">
              <div class="section-title-block max-width-210"><h2 class="heading-style-2 text-color-white">Key <span class="heading-style-2-wht">Benefits</span></h2></div>
              <div class="section-summary-block max-width-400"><p class="paragraph-small text-color-white _80">Partnering with us means access to premium craftsmanship and unmatched expertise</p></div>
            </div>
            <div class="key-benefit-content-block">
              <div class="key-benefit-point-block">
                <div class="key-benefit-icon-block"><img src="/images/Key-Benefit-Icon.svg" loading="lazy" alt="key-benefit-icon" class="key-benefit-icon"></div>
                <div class="key-benefit-text-block"><div class="paragraph-small text-color-white">Increase property value curb appeal</div></div>
              </div>
              <div class="key-benefit-point-block">
                <div class="key-benefit-icon-block"><img src="/images/Key-Benefit-Icon.svg" loading="lazy" alt="key-benefit-icon" class="key-benefit-icon"></div>
                <div class="key-benefit-text-block"><div class="paragraph-small text-color-white">Custom designs to match your vision</div></div>
              </div>
              <div class="key-benefit-point-block">
                <div class="key-benefit-icon-block"><img src="/images/Key-Benefit-Icon.svg" loading="lazy" alt="key-benefit-icon" class="key-benefit-icon"></div>
                <div class="key-benefit-text-block"><div class="paragraph-small text-color-white">Extended warranty coverage</div></div>
              </div>
              <div class="key-benefit-point-block">
                <div class="key-benefit-icon-block"><img src="/images/Key-Benefit-Icon.svg" loading="lazy" alt="key-benefit-icon" class="key-benefit-icon"></div>
                <div class="key-benefit-text-block"><div class="paragraph-small text-color-white">Licensed and insured professionals</div></div>
              </div>
              <div class="key-benefit-point-block">
                <div class="key-benefit-icon-block"><img src="/images/Key-Benefit-Icon.svg" loading="lazy" alt="key-benefit-icon" class="key-benefit-icon"></div>
                <div class="key-benefit-text-block"><div class="paragraph-small text-color-white">Quality materials from trusted brands</div></div>
              </div>
              <div class="key-benefit-point-block">
                <div class="key-benefit-icon-block"><img src="/images/Key-Benefit-Icon.svg" loading="lazy" alt="key-benefit-icon" class="key-benefit-icon"></div>
                <div class="key-benefit-text-block"><div class="paragraph-small text-color-white">Competitive pricing</div></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="section_process" class="section_process">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="process-wrapper">
            <div class="section-heading-block bottom-space-between">
              <div class="section-title-block max-width-430"><h2 class="heading-style-2">Our Roofing <span class="heading-style-2-ht">Process</span></h2></div>
              <div class="section-summary-block max-width-300"><p class="paragraph-small">A streamlined, transparent process designed for your peace of mind</p></div>
            </div>
            <div class="process-content-block is-desktop">
              <div class="process-card-block image">
                <div class="process-card-image-block"><img loading="lazy" src="/images/process-card-image.jpg" alt="process-card-image" class="process-card-image"></div>
              </div>
              <div class="process-card-block is-1">
                <div class="process-card-content-block is-1">
                  <div class="process-card-top-block">
                    <div class="process-card-icon-block"><img loading="lazy" src="/images/Icon.svg" alt="process-card-icon" class="process-card-icon"></div>
                    <div class="label-medium">Step 1</div>
                  </div>
                  <div class="process-card-bottom-block">
                    <div class="label-large">Initial Consultation</div>
                    <p class="paragraph-small">Contact us for a free consultation. We discuss your needs, timeline, and budget.</p>
                  </div>
                </div>
              </div>
              <div class="process-card-block is-1">
                <div class="process-card-content-block is-1">
                  <div class="process-card-top-block">
                    <div class="process-card-icon-block"><img loading="lazy" src="/images/Icon-1.svg" alt="process-card-icon" class="process-card-icon"></div>
                    <div class="label-medium">Step 2</div>
                  </div>
                  <div class="process-card-bottom-block">
                    <div class="label-large">Free Inspection</div>
                    <p class="paragraph-small">We evaluate your roof condition and provide comprehensive findings.</p>
                  </div>
                </div>
              </div>
              <div class="process-card-block is-1">
                <div class="process-card-content-block is-1">
                  <div class="process-card-top-block">
                    <div class="process-card-icon-block"><img loading="lazy" src="/images/Icon-2.svg" alt="process-card-icon" class="process-card-icon"></div>
                    <div class="label-medium">Step 3</div>
                  </div>
                  <div class="process-card-bottom-block">
                    <div class="label-large">Detailed Quote</div>
                    <p class="paragraph-small">Transparent itemized pricing with zero hidden fees or surprises.</p>
                  </div>
                </div>
              </div>
              <div class="process-card-block is-1">
                <div class="process-card-content-block is-1">
                  <div class="process-card-top-block">
                    <div class="process-card-icon-block"><img loading="lazy" src="/images/Icon-3.svg" alt="process-card-icon" class="process-card-icon"></div>
                    <div class="label-medium">Step 4</div>
                  </div>
                  <div class="process-card-bottom-block">
                    <div class="label-large">Professional Installation</div>
                    <p class="paragraph-small">Precision installation by master certified roofing professionals.</p>
                  </div>
                </div>
              </div>
              <div class="process-card-block is-1">
                <div class="process-card-content-block is-1">
                  <div class="process-card-top-block">
                    <div class="process-card-icon-block"><img loading="lazy" src="/images/Icon-4.svg" alt="process-card-icon" class="process-card-icon"></div>
                    <div class="label-medium">Step 5</div>
                  </div>
                  <div class="process-card-bottom-block">
                    <div class="label-large">Quality Assurance</div>
                    <p class="paragraph-small">Final walkthrough and full cleanup to guarantee your 100% satisfaction.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section_cta-two">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="cta-two-wrapper">
            <div class="cta-two-content-block">
              <div class="cta-title-block max-width-380 mobile-full"><h2 class="heading-style-2 text-color-white">Ready to Get <span class="heading-style-2-wht">Started?</span></h2></div>
              <div class="cta-summary-block"><p class="paragraph-small text-color-white _80">Contact us today for a free consultation and quote for your roofing project.</p></div>
            </div>
            <div class="cta-two-button-block">
              <a href="/contact" class="white-button is-2 w-inline-block">
                <div class="button-text-block varient-3">
                  <div class="button-text is-1 varient-4">Get Free Inspection</div>
                  <div class="button-text is-2 varient-5">Get Free Inspection</div>
                </div>
              </a>
              <a data-wf--secondary-button--variant="varient-2" href="tel:+(555)1234-5678" class="secondary-button w-variant-85a64691-fa29-aa50-59ed-622e1687be9b w-inline-block">
                <div class="button-text-block"><div class="button-text is-1">Call Now</div><div class="button-text is-2">Call Now</div></div>
                <div class="button-icon-block">
                  <div class="button-icon is-1 w-embed"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#clip0_4113_220)"><path d="M17 6.99951L7 16.9995" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M8 6.99951H17V15.9995" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></g><defs><clipPath id="clip0_4113_220"><rect width="24" height="24" fill="currentColor" transform="matrix(-1 0 0 1 24 0)"></rect></clipPath></defs></svg></div>
                  <div class="button-icon is-2 w-embed"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g clip-path="url(#clip0_4113_220)"><path d="M17 6.99951L7 16.9995" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M8 6.99951H17V15.9995" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></g><defs><clipPath id="clip0_4113_220"><rect width="24" height="24" fill="currentColor" transform="matrix(-1 0 0 1 24 0)"></rect></clipPath></defs></svg></div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
