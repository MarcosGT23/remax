---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Commercial Roofing - RoofPro Services" description="Our commercial industrial roofing solutions prioritize safety, durability, and minimal operational impact for business facilities.">
  <Header />

  <main class="main-wrapper">
    <section class="section_breadcrumb service-details is-2" style="background-image: url('/images/6992e40e90cf6ffecbb28d2c_service-card-two-image-1.jpg'); background-size: cover; background-position: 50%;">
      <div class="section-gap is-relative">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="breadcrumb-wrapper">
            <div class="breadcrumb-link-block">
              <a href="/services" class="link-button text-color-white w-inline-block">
                <div class="link-button-icon w-embed">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M19 12H5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M12 5L5 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
                <div class="button-text">Back to Services</div>
              </a>
            </div>
            <div class="breadcrumb-content-block is-3">
              <div class="breadcrumb-heading-block">
                <div class="breadcrumb-subtitle-block">
                  <div class="breadcrumb-subtitle">Service Details</div>
                </div>
                <div class="breadcrumb-title-block">
                  <h1 class="heading-style-2 text-color-white">Commercial Roofing</h1>
                </div>
              </div>
              <div class="breadcrumb-summary-block max-width-640">
                <p class="paragraph-small text-color-white">High-performance roofing systems for commercial buildings, retail centers, and enterprise properties engineered for longevity.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="breadcrumb-bg-overlay"></div>
    </section>

    <section class="section_overview">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="overview-wrapper">
            <div class="overview-content-block">
              <div class="section-title-block">
                <h2 class="heading-style-2">Overview</h2>
              </div>
              <div class="section-summary-block top-space-lg">
                <p class="paragraph-small">Our commercial roofing solutions prioritize structural safety, thermal efficiency, and minimal business interruption. We specialize in flat roof membranes, standing seam metal, TPO, PVC, and modified bitumen systems engineered to protect your assets and lower lifecycle operating costs.</p>
              </div>
            </div>
            <div class="overview-image-block is-2">
              <div class="overview-image-single-block is-1"><img src="/images/6992e40e90cf6ffecbb28d2c_service-card-two-image-1.jpg" loading="lazy" alt="service-overview-image" class="service-overview-image"></div>
              <div class="overview-image-single-block is-2"><img src="/images/6992e4162373a597380cd73c_service-card-two-image-2.jpg" loading="lazy" alt="service-overview-image" class="service-overview-image"></div>
              <div class="overview-image-single-block is-3"><img src="/images/6a5717b9f45479999f4faad7_service-details-image-1.jpg" loading="lazy" alt="service-overview-image" class="service-overview-image"></div>
              <div class="overview-image-single-block is-4"><img src="/images/6a5717b9f45479999f4faad8_service-details-image-2.jpg" loading="lazy" alt="service-overview-image" class="service-overview-image"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section_what-offer">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="what-offer-wrapper">
            <div class="section-heading-block bottom-space-between mobile-vflex">
              <div class="section-title-block max-width-210 mobile-fluid">
                <h2 class="heading-style-2">What <span class="heading-style-2-ht">We Offer</span></h2>
              </div>
              <div class="section-summary-block max-width-500 tab-top-space">
                <p class="paragraph-small">Enterprise-grade commercial systems tailored to commercial building standards</p>
              </div>
            </div>
            <div class="what-offer-content-block">
              <div class="what-offer-content-inner">
                <div class="what-offer-point-block">
                  <div class="what-offer-point-icon-block"><img src="/images/6a5717b9f45479999f4faadb_Service-Offer-Icon-1.svg" loading="lazy" alt="what-offer-point-icon" class="what-offer-point-icon"></div>
                  <div class="what-offer-point-text-block"><div class="label-medium">TPO & PVC Single-Ply Membrane Installation</div></div>
                </div>
                <div class="what-offer-point-block">
                  <div class="what-offer-point-icon-block"><img src="/images/6a5717b9f45479999f4faadc_Service-Offer-Icon-2.svg" loading="lazy" alt="what-offer-point-icon" class="what-offer-point-icon"></div>
                  <div class="what-offer-point-text-block"><div class="label-medium">Standing Seam Commercial Metal Roofing</div></div>
                </div>
                <div class="what-offer-point-block">
                  <div class="what-offer-point-icon-block"><img src="/images/6a5717b9f45479999f4faadd_Service-Offer-Icon-3.svg" loading="lazy" alt="what-offer-point-icon" class="what-offer-point-icon"></div>
                  <div class="what-offer-point-text-block"><div class="label-medium">Preventative Maintenance & Inspection Plans</div></div>
                </div>
                <div class="what-offer-point-block">
                  <div class="what-offer-point-icon-block"><img src="/images/6a5717b9f45479999f4faade_Service-Offer-Icon-4.svg" loading="lazy" alt="what-offer-point-icon" class="what-offer-point-icon"></div>
                  <div class="what-offer-point-text-block"><div class="label-medium">Fluid-Applied Roof Restorations</div></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section_key-benefit">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="key-benefit-wrapper">
            <div class="section-heading-block bottom-space-between bottom-space">
              <div class="section-title-block max-width-210"><h2 class="heading-style-2 text-color-white">Key <span class="heading-style-2-wht">Benefits</span></h2></div>
              <div class="section-summary-block max-width-400"><p class="paragraph-small text-color-white _80">Unmatched warranties and zero business disruption during installation</p></div>
            </div>
            <div class="key-benefit-content-block">
              <div class="key-benefit-point-block">
                <div class="key-benefit-icon-block"><img src="/images/Key-Benefit-Icon.svg" loading="lazy" alt="key-benefit-icon" class="key-benefit-icon"></div>
                <div class="key-benefit-text-block"><div class="paragraph-small text-color-white">Reduced energy and HVAC costs</div></div>
              </div>
              <div class="key-benefit-point-block">
                <div class="key-benefit-icon-block"><img src="/images/Key-Benefit-Icon.svg" loading="lazy" alt="key-benefit-icon" class="key-benefit-icon"></div>
                <div class="key-benefit-text-block"><div class="paragraph-small text-color-white">20+ Year NDL manufacturer warranties</div></div>
              </div>
              <div class="key-benefit-point-block">
                <div class="key-benefit-icon-block"><img src="/images/Key-Benefit-Icon.svg" loading="lazy" alt="key-benefit-icon" class="key-benefit-icon"></div>
                <div class="key-benefit-text-block"><div class="paragraph-small text-color-white">Dedicated safety and project supervision</div></div>
              </div>
              <div class="key-benefit-point-block">
                <div class="key-benefit-icon-block"><img src="/images/Key-Benefit-Icon.svg" loading="lazy" alt="key-benefit-icon" class="key-benefit-icon"></div>
                <div class="key-benefit-text-block"><div class="paragraph-small text-color-white">Full compliance with building regulations</div></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section_cta-two">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="cta-two-wrapper">
            <div class="cta-two-content-block">
              <div class="cta-title-block max-width-380 mobile-full"><h2 class="heading-style-2 text-color-white">Ready to Get <span class="heading-style-2-wht">Started?</span></h2></div>
              <div class="cta-summary-block"><p class="paragraph-small text-color-white _80">Contact us today for a free commercial consultation and quote.</p></div>
            </div>
            <div class="cta-two-button-block">
              <a href="/contact" class="white-button is-2 w-inline-block">
                <div class="button-text-block varient-3">
                  <div class="button-text is-1 varient-4">Get Commercial Quote</div>
                  <div class="button-text is-2 varient-5">Get Commercial Quote</div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
