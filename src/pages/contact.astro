---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us || Roofing Services Website Template" description="Ready to start your roofing project? Contact RoofPro Services today for a free consultation and quote.">
  <Header />

  <main class="main-wrapper">
    <section data-wf--section-cta--variant="varient-2" class="section_cta w-variant-3db7a088-545b-1ed6-55fc-297052c5a129">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="cta-wrapper">
            <div class="get-in-touch-block">
              <div class="get-in-touch-heding-block">
                <h2 class="heading-style-2 text-color-white">Get in Touch</h2>
                <p class="paragraph-small text-color-white">Ready to start your roofing project? Contact us today for a free consultation and quote.</p>
              </div>
              <div class="get-in-touch-content-block">
                <div class="get-in-touch-single-block">
                  <div class="get-in-touch-icon-block"><img loading="lazy" src="/images/Call-Icon.svg" alt="get-in-touch-icon" class="get-in-touch-icon"></div>
                  <div class="get-in-touch-text-block">
                    <div class="label-medium text-color-white">Phone</div>
                    <a href="tel:+15551234567" class="get-in-touch-link hover">+1 (555) 123-4567</a>
                  </div>
                </div>
                <div class="get-in-touch-single-block">
                  <div class="get-in-touch-icon-block"><img loading="lazy" src="/images/Mail-Icon.svg" alt="get-in-touch-icon" class="get-in-touch-icon"></div>
                  <div class="get-in-touch-text-block">
                    <div class="label-medium text-color-white">Email</div>
                    <a href="mailto:info@example.com" class="get-in-touch-link hover">info@example.com</a>
                  </div>
                </div>
                <div class="get-in-touch-single-block">
                  <div class="get-in-touch-icon-block"><img loading="lazy" src="/images/watch-Icon.svg" alt="get-in-touch-icon" class="get-in-touch-icon"></div>
                  <div class="get-in-touch-text-block">
                    <div class="label-medium text-color-white">Business Hours</div>
                    <div class="get-in-touch-link">Mon - Fri: 7:00 AM - 5:00 PM<br>Emergency available 24/7</div>
                  </div>
                </div>
                <div class="get-in-touch-single-block">
                  <div class="get-in-touch-icon-block"><img loading="lazy" src="/images/Location-Icon.svg" alt="get-in-touch-icon" class="get-in-touch-icon"></div>
                  <div class="get-in-touch-text-block">
                    <div class="label-medium text-color-white">Location</div>
                    <div class="get-in-touch-link">123 Example Street, Example City</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="contact-form-block w-form">
              <form id="email-form" name="email-form" class="contact-form" onsubmit="event.preventDefault(); alert('Thank you! Your message has been sent.');">
                <div class="contact-form-content">
                  <div class="contact-form-title-block">
                    <h3 class="heading-style-3 text-weight-semi-bold">Contact Details</h3>
                  </div>
                  <div class="contact-form-row">
                    <div class="form-field-block">
                      <label for="Name" class="label-regular">Your Full Name</label>
                      <input class="form-text-field w-input" maxlength="256" name="Name" placeholder="Enter your name" type="text" id="Name" required="">
                    </div>
                    <div class="form-field-block">
                      <label for="email" class="label-regular">Your Email Address</label>
                      <input class="form-text-field w-input" maxlength="256" name="email" placeholder="Enter Email Address" type="email" id="email" required="">
                    </div>
                  </div>
                  <div class="contact-form-row">
                    <div class="form-field-block">
                      <label for="Phone" class="label-regular">Your Phone Number</label>
                      <input class="form-text-field w-input" maxlength="256" name="Phone" placeholder="Enter Phone Number" type="tel" id="Phone" required="">
                    </div>
                    <div class="form-field-block">
                      <label for="field-2" class="label-regular">Service Required</label>
                      <select id="field-2" name="field-2" class="form-text-field select w-select">
                        <option value="Residential Roofing">Residential Roofing</option>
                        <option value="Commercial Roofing">Commercial Roofing</option>
                        <option value="Industrial Roofing">Industrial Roofing</option>
                        <option value="Retail Roofing">Retail Roofing</option>
                      </select>
                    </div>
                  </div>
                  <div class="form-field-block">
                    <label for="field" class="label-regular">Message</label>
                    <textarea id="field" name="field" maxlength="5000" placeholder="Write Message" class="form-text-field lg w-input"></textarea>
                  </div>
                  <div class="contact-form-button-block">
                    <input type="submit" class="primary-button form w-button" value="Submit">
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
