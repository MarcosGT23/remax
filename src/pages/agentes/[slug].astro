      bio: "Con más de 8 años en el mercado inmobiliario de Santa Cruz, Carlos se ha posicionado como líder en la comercialización de viviendas residenciales de alto valor, condominios cerrados y penthouses exclusivos en Equipetrol y Urubó.",
      whatsapp: "https://wa.me/59171234567",
      instagram: "https://instagram.com/remax.bolivia",
      facebook: "https://facebook.com/remaxbolivia"
    },
    {
      slug: "maria-fernanda-claros",
      name: "María Fernanda Claros",
      specialty: "Departamentos & Alquileres Ejecutivos",
      role: "Especialista en Departamentos y Alquileres",
      phone: "+591 765 43210",
      email: "maria.claros@remax.bo",
      propertiesCount: 24,
      image: "/images/avatar-02_1avatar-02.png",
      city: "La Paz",
      zone: "Calacoto / Sopocachi",
      experience: "6+ años de experiencia",
      isFeatured: false,
      bio: "María Fernanda destaca por su atención personalizada para inversionistas y diplomáticos en la Zona Sur de La Paz, facilitando alquileres de alta gama y departamentos residenciales de primera categoría.",
      whatsapp: "https://wa.me/59176543210",
      instagram: "https://instagram.com/remax.bolivia",
      facebook: "https://facebook.com/remaxbolivia"
    },
    {
      slug: "roberto-gutierrez",
      name: "Roberto Gutierrez",
      specialty: "Anticréticos & Terrenos de Inversión",
      role: "Asesor Comercial de Anticréticos y Terrenos",
      phone: "+591 789 01234",
      email: "roberto.gutierrez@remax.bo",
      propertiesCount: 15,
      image: "/images/avatar-03_1avatar-03.png",
      city: "Cochabamba",
      zone: "Sarco / Zona Norte",
      experience: "10+ años de experiencia",
      isFeatured: false,
      bio: "Roberto cuenta con amplia trayectoria en asesoría legal inmobiliaria, negociaciones de anticréticos y comercialización de terrenos con alta plusvalía en Cochabamba.",
      whatsapp: "https://wa.me/59178901234",
      instagram: "https://instagram.com/remax.bolivia",
      facebook: "https://facebook.com/remaxbolivia"
    },
    {
      slug: "andrea-siles",
      name: "Andrea Siles",
      specialty: "Inmuebles Comerciales & Locales",
      role: "Consultora Inmobiliaria de Inmuebles Comerciales",
      phone: "+591 700 98765",
      email: "andrea.siles@remax.bo",
      propertiesCount: 12,
      image: "/images/avatar-01_1avatar-01.png",
      city: "Santa Cruz",
      zone: "Centro / Sirari",
      experience: "5+ años de experiencia",
      isFeatured: false,
      bio: "Especialista en la intermediación de espacios corporativos, oficinas comerciales y terrenos industriales estratégicos en Santa Cruz.",
      whatsapp: "https://wa.me/59170098765",
      instagram: "https://instagram.com/remax.bolivia",
      facebook: "https://facebook.com/remaxbolivia"
    },
    {
      slug: "gabriel-morales",
      name: "Gabriel Morales",
      specialty: "Asesoría Financiera & Proyectos VIP",
      role: "Asesor Financiero e Inmobiliario VIP",
      phone: "+591 733 11223",
      email: "gabriel.morales@remax.bo",
      propertiesCount: 21,
      image: "/images/avatar-02_1avatar-02.png",
      city: "La Paz",
      zone: "Achumani / San Miguel",
      experience: "7+ años de experiencia",
      isFeatured: true,
      bio: "Gabriel integra análisis financiero de inversión con gestión inmobiliaria para asegurar retornos óptimos en compraventas de departamentos y proyectos verticales en La Paz.",
      whatsapp: "https://wa.me/59173311223",
      instagram: "https://instagram.com/remax.bolivia",
      facebook: "https://facebook.com/remaxbolivia"
    },
    {
      slug: "valeria-roca",
      name: "Valeria Roca",
      specialty: "Ventas Residencia & Desarrollo de Proyectos",
      role: "Agente Certificada en Ventas y Proyectos",
      phone: "+591 722 44556",
      email: "valeria.roca@remax.bo",
      propertiesCount: 19,
      image: "/images/avatar-03_1avatar-03.png",
      city: "Cochabamba",
      zone: "Queru Queru / América",
      experience: "4+ años de experiencia",
      isFeatured: false,
      bio: "Valeria lidera la comercialización de emprendimientos inmobiliarios modernos y viviendas familiares en Cochabamba con asesoramiento transparente en cada etapa.",
      whatsapp: "https://wa.me/59172244556",
      instagram: "https://instagram.com/remax.bolivia",
      facebook: "https://facebook.com/remaxbolivia"
    }
  ];

const { slug } = Astro.params;
const agent = agentsList.find(a => a.slug === slug) || agentsList[0];

// Mock properties managed by this specific agent
const agentProperties = [
  {
    id: "prop-3",
    type: "Casa Moderna de Lujo",
    price: "245,000",
    address: `Av. Banzer Km 8.5, ${agent.city}`,
    features: ["450 m²", "320 m²", "4", "5"],
    badgeTitle: "Venta",
    badgeClass: "badge-sale",
    image: "/images/6a5717b9f45479999f4faad2_our-work-thumbnail-1.jpg"
  },
  {
    id: "alquiler-local-comercial-santa-cruz-villa-1ro-de-mayo-1200986298-28",
    type: "Departamento Ejecutivo 2D",
    price: "850",
    address: `Barrio Sirari, ${agent.city}`,
    features: ["110 m²", "100 m²", "2", "2"],
    badgeTitle: "Alquiler",
    badgeClass: "badge-rent",
    image: "/images/6a5717b9f45479999f4faad0_our-work-thumbnail-2.jpg"
  },
  {
    id: "prop-1",
    type: "Terreno Residencial en Condominio",
    price: "115,000",
    address: `Zona Residencial, ${agent.city}`,
    features: ["600 m²", "0 m²", "0", "0"],
    badgeTitle: "Venta",
    badgeClass: "badge-sale",
    image: "/images/industrial-roofing.webp"
  }
];

const computedInitials = agent.name.split(' ').map((n: string) => n[0]).join('').substring(0, 2).toUpperCase();

// Generate WhatsApp link dynamically from agent.phone
const phoneDigits = agent.phone ? agent.phone.replace(/[^\d]/g, '') : '';
const cleanPhoneDigits = phoneDigits.startsWith('591') ? phoneDigits : `591${phoneDigits}`;
const whatsappUrl = `https://wa.me/${cleanPhoneDigits}?text=Hola%20${encodeURIComponent(agent.name)},%20estoy%20interesado%20en%20tus%20servicios%20inmobiliarios.`;
---

<Layout title={`${agent.name} | Agente Inmobiliario RE/MAX Bolivia`} description={`Perfil profesional de ${agent.name}, ${agent.role} en ${agent.city}. Revisa sus propiedades disponibles y contacta directamente.`}>
  <Header />

  <main class="main-wrapper">
    <PageHeader
      badge="Perfil de Agente Certificado"
      title={agent.name}
      subtitle={agent.role}
      backLink="/agentes"
    />

    <!-- Agent Detail Header Profile Section -->
    <section class="agent-profile-section">
      <div class="container-main">
        <div class="agent-profile-card">
          <!-- Left: Big Avatar Frame -->
          <div class="profile-avatar-col">
            <div class="profile-avatar-frame">
              {agent.image ? (
                <img src={agent.image} alt={agent.name} class="profile-avatar-img" />
              ) : (
                <div class="profile-avatar-fallback">{computedInitials}</div>
              )}
            </div>
            <span class="experience-pill">{agent.experience}</span>
          </div>

          <!-- Right: Detailed Info & Bio -->
          <div class="profile-details-col">
            <div class="profile-header-row">
              <div>
                <h1 class="profile-agent-name">{agent.name}</h1>
                <p class="profile-agent-specialty">{agent.specialty}</p>
              </div>
              {agent.isFeatured && <span class="profile-destacado-badge">DESTACADO</span>}
            </div>

            <div class="profile-meta-tags">
              <span class="meta-tag">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {agent.city} ({agent.zone})
              </span>
              <span class="meta-tag">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                </svg>
                {agent.propertiesCount} Propiedades gestionadas
              </span>
            </div>

            <p class="profile-bio-text">{agent.bio}</p>

            <!-- Social Media & Contact Links -->
            <div class="profile-contact-bar">
              <div class="social-channels">
                <span class="social-label">Redes & Contacto:</span>

                <!-- WhatsApp -->
                <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="social-btn whatsapp-social" title="WhatsApp">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                  </svg>
                  <span>WhatsApp</span>
                </a>

                <!-- Instagram -->
                <a href={agent.instagram} target="_blank" rel="noopener noreferrer" class="social-btn instagram-social" title="Instagram">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                  <span>Instagram</span>
                </a>

                <!-- Facebook -->
                <a href={agent.facebook} target="_blank" rel="noopener noreferrer" class="social-btn facebook-social" title="Facebook">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                  </svg>
                  <span>Facebook</span>
                </a>

                <!-- Correo -->
                <a href={`mailto:${agent.email}`} class="social-btn email-social" title="Enviar Correo">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                  <span>{agent.email}</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Properties Managed by Agent Section -->
    <section class="agent-properties-section">
      <div class="container-main">
        <div class="section-title-wrap">
          <h2>Propiedades gestionadas por {agent.name}</h2>
          <p>Explora la cartera activa de inmuebles disponibles para venta o alquiler en {agent.city}.</p>
        </div>

        <div class="properties-grid">
          {agentProperties.map((p) => (
            <PropertyCard
              id={p.id}
              type={p.type}
              price={p.price}
              address={p.address}
              features={p.features}
              badgeTitle={p.badgeTitle}
              badgeClass={p.badgeClass}
              image={p.image}
              agentName={agent.name}
              agentRole={agent.role}
              agentPhone={agent.phone}
              agentImage={agent.image}
              agentWhatsapp={agent.whatsapp}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Direct Inquiry Contact Form Section -->
    <section class="agent-inquiry-section">
      <div class="container-main">
        <div class="inquiry-card">
          <div class="inquiry-header">
            <h2>Contactar directamente con {agent.name}</h2>
            <p>Envía tu consulta sobre una propiedad o solicita asesoramiento inmobiliario personalizado.</p>
          </div>

          <form id="agentInquiryForm" class="inquiry-form" onsubmit="event.preventDefault(); alert('¡Gracias por tu mensaje! ' + agent.name + ' se pondrá en contacto contigo a la brevedad.');">
            <div class="form-row">
              <input type="text" placeholder="Tu Nombre Completo" required class="form-input" />
              <input type="tel" placeholder="Tu Teléfono / WhatsApp" required class="form-input" />
            </div>
            <div class="form-row">
              <input type="email" placeholder="Tu Correo Electrónico" required class="form-input" />
              <select class="form-input">
                <option value="Comprar">Quiero Comprar una Propiedad</option>
                <option value="Alquilar">Quiero Alquilar una Propiedad</option>
                <option value="Vender">Quiero Vender mi Propiedad con {agent.name}</option>
                <option value="Consulta">Consulta General</option>
              </select>
            </div>
            <textarea placeholder={`Escribe tu mensaje para ${agent.name}...`} rows="4" required class="form-input textarea-input"></textarea>
            <button type="submit" class="submit-inquiry-btn">Enviar Mensaje a {agent.name}</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .container-main {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  /* Profile Header Section */
  .agent-profile-section {
    padding: 60px 0 40px;
    background-color: #f8fafc;
  }

  .agent-profile-card {
    background-color: #ffffff;
    border-radius: 28px;
    border: 1px solid #e2e8f0;
    padding: 44px;
    display: flex;
    gap: 44px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
  }

  .profile-avatar-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .profile-avatar-frame {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid #ffffff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08), 0 0 0 2px #165cfd;
    background-color: #f1f5f9;
  }

  .profile-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .profile-avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 800;
    color: #475569;
  }

  .experience-pill {
    background-color: #eff6ff;
    color: #165cfd;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid rgba(22, 92, 253, 0.15);
  }

  .profile-details-col {
    flex-grow: 1;
  }

  .profile-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 12px;
  }

  .profile-agent-name {
    font-size: 2.2rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 4px;
    letter-spacing: -0.5px;
  }

  .profile-agent-specialty {
    font-size: 1.1rem;
    color: #64748b;
    margin: 0;
    font-weight: 600;
  }

  .profile-destacado-badge {
    background-color: #0f172a;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 6px 14px;
    border-radius: 20px;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .profile-meta-tags {
    display: flex;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .meta-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    color: #64748b;
    font-weight: 600;
    background-color: #f8fafc;
    padding: 6px 14px;
    border-radius: 10px;
    border: 1px solid #f1f5f9;
  }

  .profile-bio-text {
    font-size: 1.025rem;
    color: #334155;
    line-height: 1.65;
    margin: 0 0 28px;
  }

  /* Social Channels Bar */
  .profile-contact-bar {
    padding-top: 24px;
    border-top: 1px solid #f1f5f9;
  }

  .social-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: #94a3b8;
    display: block;
    margin-bottom: 12px;
  }

  .social-channels {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .social-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 12px;
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #475569;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .social-btn.whatsapp-social:hover {
    background-color: #25d366;
    color: #ffffff;
    border-color: #25d366;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
  }

  .social-btn.instagram-social:hover {
    background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    color: #ffffff;
    border-color: #dc2743;
    box-shadow: 0 4px 14px rgba(220, 39, 67, 0.3);
  }

  .social-btn.facebook-social:hover {
    background-color: #1877f2;
    color: #ffffff;
    border-color: #1877f2;
    box-shadow: 0 4px 14px rgba(24, 119, 242, 0.3);
  }

  .social-btn.email-social:hover {
    background-color: #165cfd;
    color: #ffffff;
    border-color: #165cfd;
    box-shadow: 0 4px 14px rgba(22, 92, 253, 0.3);
  }

  /* Agent Properties Section */
  .agent-properties-section {
    padding: 70px 0;
    background-color: #ffffff;
  }

  .section-title-wrap {
    margin-bottom: 36px;
  }

  .section-title-wrap h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 8px;
    letter-spacing: -0.4px;
  }

  .section-title-wrap p {
    color: #64748b;
    font-size: 1rem;
    margin: 0;
  }

  .properties-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  /* Inquiry Form Section */
  .agent-inquiry-section {
    padding: 40px 0 90px;
    background-color: #f8fafc;
  }

  .inquiry-card {
    background-color: #ffffff;
    border-radius: 28px;
    border: 1px solid #e2e8f0;
    padding: 48px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
  }

  .inquiry-header h2 {
    font-size: 1.6rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 8px;
  }

  .inquiry-header p {
    color: #64748b;
    font-size: 0.95rem;
    margin: 0 0 32px;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-input {
    width: 100%;
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid #cbd5e1;
    background-color: #f8fafc;
    font-size: 0.95rem;
    color: #0f172a;
    outline: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .form-input:focus {
    border-color: #165cfd;
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(22, 92, 253, 0.1);
  }

  .textarea-input {
    resize: vertical;
    min-height: 110px;
  }

  .submit-inquiry-btn {
    background-color: #165cfd;
    color: #ffffff;
    border: none;
    padding: 16px 36px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
    align-self: flex-start;
    box-shadow: 0 4px 16px rgba(22, 92, 253, 0.25);
  }

  .submit-inquiry-btn:hover {
    background-color: #1d4ed8;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(22, 92, 253, 0.35);
  }

  @media screen and (max-width: 991px) {
    .agent-profile-card {
      flex-direction: column;
      padding: 32px;
    }
    .properties-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 640px) {
    .properties-grid {
      grid-template-columns: 1fr;
    }
    .inquiry-card {
      padding: 28px;
    }
  }
</style>
