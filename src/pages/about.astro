<script>
  // 1. Dynamic Scroll Timeline Animation for Our Story (.our-story-ht-liner & pointers)
  function initOurStoryScrollAnimation() {
    const container = document.querySelector('.our-story-content-block');
    const blueLiner = document.querySelector('.our-story-ht-liner') as HTMLElement;
    const pointers = document.querySelectorAll('.our-story-pointer-block');

    if (!container || !blueLiner) return;

    function updateTimeline() {
      if (!container || !blueLiner) return;
      const rect = container.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      const startY = windowHeight * 0.75;
      const totalHeight = rect.height;
      const currentScrollPos = startY - rect.top;
      
      let progress = currentScrollPos / totalHeight;
      progress = Math.max(0, Math.min(1, progress));

      blueLiner.style.transform = `scaleY(${progress})`;
      blueLiner.style.transformOrigin = 'top center';
      blueLiner.style.transition = 'transform 0.1s linear';

      pointers.forEach((pointerEl) => {
        const pointer = pointerEl as HTMLElement;
        const pointerRect = pointer.getBoundingClientRect();
        const pointerY = pointerRect.top + pointerRect.height / 2;
        
        if (pointerY <= startY) {
          pointer.style.transform = 'scale(1.3)';
          pointer.style.borderColor = 'var(--_colors---primary-color, #165cfd)';
          pointer.style.boxShadow = '0 0 12px rgba(22, 92, 253, 0.4)';
          pointer.style.transition = 'all 0.3s ease';
          const dot = pointer.querySelector('.our-story-pointer') as HTMLElement;
          if (dot) dot.style.opacity = '1';
        } else {
          pointer.style.transform = 'scale(1)';
          pointer.style.boxShadow = 'none';
          const dot = pointer.querySelector('.our-story-pointer') as HTMLElement;
          if (dot) dot.style.opacity = '0.3';
        }
      });
    }

    window.addEventListener('scroll', updateTimeline, { passive: true });
    updateTimeline();
  }

  // 2. Interactive Purpose Tabs
  function initPurposeTabs() {
    const tabLinks = document.querySelectorAll('.our-purpose-tab-link');
    const tabPanes = document.querySelectorAll('.our-purpose-tab-pane');

    tabLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const tabTarget = link.getAttribute('data-w-tab');

        tabLinks.forEach((l) => l.classList.remove('w--current', 'active'));
        link.classList.add('w--current', 'active');

        tabPanes.forEach((pane) => {
          if (pane.getAttribute('data-w-tab') === tabTarget) {
            pane.classList.add('w--tab-active');
            (pane as HTMLElement).style.display = 'block';
          } else {
            pane.classList.remove('w--tab-active');
            (pane as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  // 3. Team Member Slider Controls
  function initTeamSliderControls() {
    const track = document.querySelector('.team-slider-track') as HTMLElement;
    const prevBtn = document.querySelector('.team-prev-btn');
    const nextBtn = document.querySelector('.team-next-btn');

    if (!track || !prevBtn || !nextBtn) return;

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -304, behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: 304, behavior: 'smooth' });
    });
  }

  // 4. Scroll Reveal for General Elements
  function initScrollObserver() {
    const targets = document.querySelectorAll('.animate-on-scroll');
    
    targets.forEach((el) => {
      const element = el as HTMLElement;
      element.style.transition = 'opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.8s cubic-bezier(0.16, 1, 0.3, 1)';
      element.style.opacity = '0';
      element.style.filter = 'blur(8px)';
      element.style.transform = 'translate3d(0, 35px, 0)';
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const element = entry.target as HTMLElement;
          element.style.opacity = '1';
          element.style.filter = 'blur(0px)';
          element.style.transform = 'translate3d(0, 0, 0)';
          observer.unobserve(element);
        }
      });
    }, { threshold: 0.1 });

    targets.forEach((target) => observer.observe(target));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initOurStoryScrollAnimation();
      initPurposeTabs();
      initTeamSliderControls();
      initScrollObserver();
    });
  } else {
    initOurStoryScrollAnimation();
    initPurposeTabs();
    initTeamSliderControls();
    initScrollObserver();
  }
</script>
