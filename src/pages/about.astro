                <!-- Tab Panes -->
                <div class="our-purpose-tab-content w-tab-content">
                  
                  <!-- Mission Pane (Tab 1) -->
                  <div data-w-tab="Tab 1" class="our-purpose-tab-pane purpose-pane w-tab-pane w--tab-active">
                    <div class="our-purpose-tab-content-inner">
