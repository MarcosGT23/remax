                          <path d="M7.99951 7H16.9995V16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </g>
                        <defs><clipPath id="clip0_4125_314"><rect width="24" height="24" fill="currentColor"></rect></clipPath></defs>
                      </svg>
                    </div>
