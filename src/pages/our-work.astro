---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Our Work || Roofing Services Website Template" description="Browse our portfolio of completed residential and commercial roofing projects across Brisbane.">
  <Header />

  <main class="main-wrapper">
    <section class="section_our-work">
      <div class="section-gap">
        <div class="w-layout-blockcontainer container-main w-container">
          <div class="our-work-wrapper">
            <div class="section-heading-block bottom-space-between">
              <div class="section-title-block max-width-300">
                <h2 class="heading-style-2">Our Work <span class="heading-style-2-ht">Showcase</span></h2>
              </div>
              <div class="section-summary-block max-width-400">
                <p class="paragraph-small">Browse our portfolio of completed roofing projects across Brisbane</p>
              </div>
            </div>
            
            <div class="our-work-content-block is-desktop">
              
              <!-- First Row of Projects -->
              <div class="our-work-collection-block w-dyn-list">
                <div role="list" class="our-work-collection-list w-dyn-items">
                  
                  <!-- Card 1 -->
                  <div role="listitem" class="our-work-collection-item w-dyn-item">
                    <div class="our-work-item-block">
                      <a href="/our-works/families-and-individuals-who-want-secure-long-lasting-roofs" class="our-work-item-image-block w-inline-block">
                        <img src="/images/6a5717b9f45479999f4faad2_our-work-thumbnail-1.jpg" loading="lazy" alt="our-work-item-thumbnail" class="our-work-item-thumbnail">
                      </a>
                      <div class="our-work-item-content-block">
                        <div class="our-work-item-text-block">
                          <div class="our-work-item-tag">Homeowners</div>
                          <a aria-label="our-work-item-title-block" href="/our-works/families-and-individuals-who-want-secure-long-lasting-roofs" class="our-work-item-title-block w-inline-block">
                            <h3 class="label-xlarge hover">Families and individuals who want secure, long-lasting roofs</h3>
                          </a>
                          <p>Urban residential communities where we support families needing durable, long-term roof protection.</p>
                        </div>
                        <div class="our-work-item-button-block">
                          <a href="/our-works/families-and-individuals-who-want-secure-long-lasting-roofs" class="link-button w-inline-block">
                            <div class="button-text lg">Read More</div>
                            <div class="link-button-icon w-embed">
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                              </svg>
                            </div>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Card 2 -->
                  <div role="listitem" class="our-work-collection-item w-dyn-item">
                    <div class="our-work-item-block">
                      <a href="/our-works/businesses-looking-for-strong-low-maintenance-roofing" class="our-work-item-image-block w-inline-block">
                        <img src="/images/6a5717b9f45479999f4faad0_our-work-thumbnail-2.jpg" loading="lazy" alt="our-work-item-thumbnail" class="our-work-item-thumbnail">
                      </a>
                      <div class="our-work-item-content-block">
                        <div class="our-work-item-text-block">
                          <div class="our-work-item-tag">Commercial Property</div>
                          <a aria-label="our-work-item-title-block" href="/our-works/businesses-looking-for-strong-low-maintenance-roofing" class="our-work-item-title-block w-inline-block">
                            <h3 class="label-xlarge hover">Businesses looking for strong, low-maintenance roofing</h3>
                          </a>
                          <p>Growing suburban neighborhoods with newly built homes requiring professional installation and finishing.</p>
                        </div>
                        <div class="our-work-item-button-block">
                          <a href="/our-works/businesses-looking-for-strong-low-maintenance-roofing" class="link-button w-inline-block">
                            <div class="button-text lg">Read More</div>
                            <div class="link-button-icon w-embed">
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                              </svg>
                            </div>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>

                </div>
              </div>

              <!-- Second Row of Projects -->
              <div class="our-work-collection-block top-gap w-dyn-list">
                <div role="list" class="our-work-collection-list is-2 w-dyn-items">
                  
                  <!-- Card 3 -->
                  <div role="listitem" class="our-work-collection-item w-dyn-item">
                    <div class="our-work-item-block">
                      <a href="/our-works/schools-clinics-and-community-buildings-th" class="our-work-item-image-block w-inline-block">
                        <img src="/images/6a5717b9f45479999f4faa06_our-work-thumbnail-5.jpg" loading="lazy" alt="our-work-item-thumbnail" class="our-work-item-thumbnail">
                      </a>
                      <div class="our-work-item-content-block">
                        <div class="our-work-item-text-block">
                          <div class="our-work-item-tag">Homeowners</div>
                          <a aria-label="our-work-item-title-block" href="/our-works/schools-clinics-and-community-buildings-th" class="our-work-item-title-block w-inline-block">
                            <h3 class="label-xlarge hover">Schools, clinics, and community buildings</h3>
                          </a>
                          <p>Commercial districts where offices, warehouses, and retail spaces depend on long-lasting weather shielding.</p>
                        </div>
                        <div class="our-work-item-button-block">
                          <a href="/our-works/schools-clinics-and-community-buildings-th" class="link-button w-inline-block">
                            <div class="button-text lg">Read More</div>
                            <div class="link-button-icon w-embed">
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                              </svg>
                            </div>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Card 4 -->
                  <div role="listitem" class="our-work-collection-item w-dyn-item">
                    <div class="our-work-item-block">
                      <a href="/our-works/builders-who-need-reliable-roofing-partners-to-com" class="our-work-item-image-block w-inline-block">
                        <img src="/images/6a5717b9f45479999f4faa89_our-work-thumbnail-4.jpg" loading="lazy" alt="our-work-item-thumbnail" class="our-work-item-thumbnail">
                      </a>
                      <div class="our-work-item-content-block">
                        <div class="our-work-item-text-block">
                          <div class="our-work-item-tag">Companies</div>
                          <a aria-label="our-work-item-title-block" href="/our-works/builders-who-need-reliable-roofing-partners-to-com" class="our-work-item-title-block w-inline-block">
                            <h3 class="label-xlarge hover">Builders who need reliable roofing partners to complete projects</h3>
                          </a>
                          <p>Rural locations where agricultural and farm structures need dependable roofing for barns and facilities.</p>
                        </div>
                        <div class="our-work-item-button-block">
                          <a href="/our-works/builders-who-need-reliable-roofing-partners-to-com" class="link-button w-inline-block">
                            <div class="button-text lg">Read More</div>
                            <div class="link-button-icon w-embed">
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                              </svg>
                            </div>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Card 5 -->
                  <div role="listitem" class="our-work-collection-item w-dyn-item">
                    <div class="our-work-item-block">
                      <a href="/our-works/schools-clinics-and-community-buildings-th-2" class="our-work-item-image-block w-inline-block">
                        <img src="/images/6a5717b9f45479999f4faac2_our-work-thumbnail-3.jpg" loading="lazy" alt="our-work-item-thumbnail" class="our-work-item-thumbnail">
                      </a>
                      <div class="our-work-item-content-block">
                        <div class="our-work-item-text-block">
                          <div class="our-work-item-tag">Homeowners</div>
                          <a aria-label="our-work-item-title-block" href="/our-works/schools-clinics-and-community-buildings-th-2" class="our-work-item-title-block w-inline-block">
                            <h3 class="label-xlarge hover">Schools, clinics, and community buildings restoration</h3>
                          </a>
                          <p>Commercial districts where offices, warehouses, and retail spaces depend on long-lasting protection.</p>
                        </div>
                        <div class="our-work-item-button-block">
                          <a href="/our-works/schools-clinics-and-community-buildings-th-2" class="link-button w-inline-block">
                            <div class="button-text lg">Read More</div>
                            <div class="link-button-icon w-embed">
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M5 12H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                              </svg>
                            </div>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>

                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
