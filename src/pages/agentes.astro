    box-shadow: 0 0 0 3px rgba(22, 92, 253, 0.1);
  }

  .controls-right {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  /* City Filter Pills */
  .city-pills-group {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .city-pill {
    background: none;
    border: none;
    color: #475569;
    font-size: 0.925rem;
    font-weight: 600;
    padding: 8px 18px;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .city-pill:hover {
    color: #0043ff;
  }

  .city-pill.active {
    background-color: #0f172a;
    color: #ffffff;
    font-weight: 700;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
  }

  /* View Mode Toggle Buttons */
  .view-mode-toggle {
    display: flex;
    align-items: center;
    background-color: #f1f5f9;
    padding: 4px;
    border-radius: 12px;
    gap: 4px;
  }

  .view-btn {
    background: none;
    border: none;
    padding: 8px 10px;
    border-radius: 8px;
    color: #94a3b8;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .view-btn.active {
    background-color: #ffffff;
    color: #0f172a;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
  }

  /* Count Indicator */
  .results-count-bar {
    font-size: 0.9rem;
    color: #94a3b8;
    font-weight: 600;
    margin-bottom: 32px;
  }

  /* Grid Layout (3 Columns matching mockup) */
  .agents-grid-layout {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    transition: all 0.3s ease;
  }

  /* List View */
  .agents-grid-layout.is-list-view {
    grid-template-columns: 1fr !important;
    gap: 16px !important;
  }

  /* Empty State */
  .agents-empty-state {
    text-align: center;
    background: #ffffff;
    padding: 60px 24px;
    border-radius: 24px;
    border: 1px solid #e2e8f0;
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: 12px;
  }

  .agents-empty-state h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 6px;
  }

  .agents-empty-state p {
    color: #64748b;
    font-size: 0.925rem;
    margin: 0;
  }

  /* Join Team Section (Cream & Minimalist Animated) */
  .join-team-section {
    padding: 40px 0 90px;
    background-color: #f7f5ee;
  }

  .join-card {
    background: #f7f5ee; /* Elegant warm cream tone */
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 24px;
    padding: 56px 48px;
    color: #0f172a;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.04);
    position: relative;
    overflow: hidden;
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease;
  }

  .join-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .join-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.08);
  }

  .join-badge {
    background: rgba(190, 18, 60, 0.08);
    color: #ff1200;
    border: 1px solid rgba(190, 18, 60, 0.2);
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    display: inline-block;
    margin-bottom: 18px;
  }

  .join-content h2 {
    font-size: 2.2rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 16px;
    line-height: 1.3;
    letter-spacing: -0.5px;
  }

  .join-content p {
    font-size: 1.05rem;
    color: #475569;
    max-width: 680px;
    line-height: 1.65;
    margin: 0 0 32px;
  }

  .join-btn {
